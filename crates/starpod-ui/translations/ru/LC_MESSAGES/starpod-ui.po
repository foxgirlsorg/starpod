msgstr "Альфа-версии выходят первыми и могут быть менее стабильными."

msgid "Latest"
msgstr "Последняя"

msgid "Not checked yet"
msgstr "Ещё не проверялось"

msgid "Version {} is available on this channel"
msgstr "Версия {} доступна в этом канале"

msgid "Up to date on this channel"
msgstr "В этом канале актуально"

msgid "Check"
msgstr "Проверить"

msgid "Upgrade"
msgstr "Обновить"

msgid "Logs and tests"
msgstr "Журнал и проверки"

msgid "Log level"
msgstr "Уровень журнала"

msgid "How much the engine writes to the Logs screen."
msgstr "Сколько ядро записывает в журнал."

msgid "Choose"
msgstr "Выбрать"

msgid "Log retention"
msgstr "Хранение журнала"

msgid "Lines kept on the Logs screen. Empty uses the app default."
msgstr "Строк сохраняется в журнале. Пусто — значение приложения по умолчанию."

msgid "Lines"
msgstr "строк"

msgid "Delay test URL"
msgstr "Адрес проверки задержки"

msgid "The address latency tests request. Empty uses the app default."
msgstr "Адрес, к которому обращаются проверки задержки. Пусто — значение приложения по умолчанию."

msgid "Delay test timeout"
msgstr "Таймаут проверки задержки"

msgid "How long a latency test waits for an answer. Empty uses the app default."
msgstr "Сколько проверка задержки ждёт ответа. Пусто — значение приложения по умолчанию."

msgid "ms"
msgstr "мс"

msgid "Find process"
msgstr "Определять процесс"

msgid "When the engine names the program behind a connection."
msgstr "Когда ядро называет программу, стоящую за соединением."

msgid "Unified delay"
msgstr "Единая задержка"

msgid "Measures latency after the first handshake, so the results compare fairly."
msgstr "Измеряет задержку после первого рукопожатия, чтобы результаты были сравнимы."

msgid "TCP concurrent"
msgstr "Параллельный TCP"

msgid "Tries several addresses at once to connect faster."
msgstr "Пробует сразу несколько адресов, чтобы подключаться быстрее."

msgid "Keep-alive interval"
msgstr "Интервал keep-alive"

msgid "How often idle connections are probed, in seconds. Empty uses the engine default."
msgstr "Как часто проверяются простаивающие соединения, в секундах. Пусто — значение ядра по умолчанию."

msgid "Seconds"
msgstr "сек"

msgid "Proxy groups"
msgstr "Группы прокси"

msgid "Close connections on switch"
msgstr "Закрывать соединения при переключении"

msgid "When you pick a server in a group, closes the connections that went through the old one."
msgstr "Когда вы выбираете сервер в группе, закрываются соединения, шедшие через прежний."

msgid "Device identification"
msgstr "Идентификация устройства"

msgid "Send device identification"
msgstr "Отправлять данные об устройстве"

msgid "With each subscription request, sends a device ID, the operating system, its version and the device model, so the provider can count your devices. Off sends none of them."
msgstr "С каждым запросом подписки отправляются ID устройства, операционная система, её версия и модель устройства, чтобы провайдер мог посчитать ваши устройства. Выключено — ничего не отправляется."

msgid "Global shortcuts"
msgstr "Глобальные горячие клавиши"

msgid "They work from any app. Write them as Ctrl+Alt+KeyS. Empty turns a shortcut off."
msgstr "Работают из любого приложения. Записывайте их как Ctrl+Alt+KeyS. Пусто — горячая клавиша выключена."

msgid "Show the window"
msgstr "Показать окно"

msgid "Brings the Starpod window to the front."
msgstr "Выводит окно Starpod на передний план."

msgid "Connect or disconnect"
msgstr "Подключить или отключить"

msgid "Starts or stops the engine."
msgstr "Запускает или останавливает ядро."

msgid "Turn the system proxy on or off"
msgstr "Включить или выключить системный прокси"

msgid "Changes the system proxy setting."
msgstr "Меняет настройку системного прокси."

msgid "Rule-based mode"
msgstr "Режим по правилам"

msgid "Switches the routing mode."
msgstr "Переключает режим маршрутизации."

msgid "Discard"
msgstr "Отменить"

msgid "Save shortcuts"
msgstr "Сохранить горячие клавиши"

