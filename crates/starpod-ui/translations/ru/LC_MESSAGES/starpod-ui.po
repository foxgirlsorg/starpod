msgstr "Ожидаем, пока ядро прокси передаст свои настройки."

msgid "Interface"
msgstr "Интерфейс"

msgid "Language"
msgstr "Язык"

msgid "Applies to the whole app, including the tray."
msgstr "Применяется ко всему приложению, включая трей."

msgid "Startup"
msgstr "Запуск"

msgid "Start at login"
msgstr "Запускать при входе в систему"

msgid "Starts Starpod when you log in."
msgstr "Запускает Starpod при входе в систему."

msgid "Start in the tray"
msgstr "Запускать в трее"

msgid "A start at login stays in the tray instead of showing the window."
msgstr "Запуск при входе остаётся в трее и не открывает окно."

msgid "Close to tray"
msgstr "Закрывать в трей"

msgid "Closing the window hides Starpod to the tray and the proxy keeps running. Off quits Starpod and stops the engine."
msgstr "Закрытие окна прячет Starpod в трей, прокси продолжает работать. Если выключено, Starpod закрывается и останавливает ядро."

msgid "This desktop has no tray, so closing always quits."
msgstr "На этом рабочем столе нет трея, поэтому закрытие всегда завершает программу."

msgid "Connect on start"
msgstr "Подключаться при запуске"

msgid "Connects once the saved state has loaded, when a subscription has servers."
msgstr "Подключается после загрузки сохранённого состояния, если в подписке есть серверы."

msgid "Routing and subscriptions"
msgstr "Маршрутизация и подписки"

msgid "Routing mode"
msgstr "Режим маршрутизации"

msgid "Rule-based follows your rules. Global sends everything through the selected server. Direct uses no proxy."
msgstr "По правилам — трафик идёт по вашим правилам. Глобальный — весь трафик через выбранный сервер. Прямой — без прокси."

msgid "The active subscription does not allow Global. Rule-based follows your rules."
msgstr "Текущая подписка не разрешает глобальный режим. Работает режим по правилам."

msgid "Auto-update every"
msgstr "Автообновление каждые"

msgid "How often subscriptions are refreshed in the background."
msgstr "Как часто подписки обновляются в фоновом режиме."

msgid "Custom"
msgstr "Свой"

msgid "Updates"
msgstr "Обновления"

msgid "Check for updates at startup"
msgstr "Проверять обновления при запуске"

msgid "Asks GitHub for a newer release when Starpod starts. Nothing is downloaded."
msgstr "При запуске Starpod спрашивает GitHub о новой версии. Ничего не загружается."

msgid "Check now"
msgstr "Проверить сейчас"

msgid "Looks for a newer release on GitHub."
msgstr "Ищет новую версию на GitHub."

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Update available"
msgstr "Доступно обновление"

msgid "Version {} is on GitHub. It is not installed for you."
msgstr "Версия {} есть на GitHub. Она не установлена автоматически."

msgid "Open release page"
msgstr "Открыть страницу релиза"

msgid "Ports"
msgstr "Порты"

msgid "Mixed port"
msgstr "Смешанный порт"

msgid "HTTP and SOCKS5 on one port. Empty uses the default."
msgstr "HTTP и SOCKS5 на одном порту. Пусто — порт по умолчанию."

msgid "Another listener already uses this port."
msgstr "Этот порт уже занят другим слушателем."

msgid "SOCKS5 port"
msgstr "Порт SOCKS5"

msgid "SOCKS5 only. Empty uses the default."
msgstr "Только SOCKS5. Пусто — порт по умолчанию."

msgid "HTTP port"
msgstr "Порт HTTP"

msgid "HTTP only. Empty turns it off."
msgstr "Только HTTP. Пусто — выключает его."

msgid "Access"
msgstr "Доступ"

msgid "Allow LAN"
msgstr "Разрешить доступ из сети"

msgid "Lets other devices on your network use the proxy."
msgstr "Позволяет другим устройствам в сети использовать прокси."

msgid "Exposed: any device on your network can use it."
msgstr "Открыто: любое устройство в сети может им пользоваться."

msgid "Bind address"
msgstr "Адрес привязки"

msgid "The address the listeners bind to. Empty uses 127.0.0.1."
msgstr "Адрес, к которому привязываются слушатели. Пусто — 127.0.0.1."

msgid "Turn on Allow LAN to change the bind address."
msgstr "Включите «Разрешить доступ из сети», чтобы изменить адрес привязки."

msgid "IPv6"
msgstr "IPv6"

msgid "Default leaves the engine's choice."
msgstr "По умолчанию — выбор ядра."

msgid "Set the system proxy"
msgstr "Настраивать системный прокси"

msgid "Active. The system proxy points at Starpod."
msgstr "Включено. Системный прокси указывает на Starpod."

msgid "Not active. The system proxy follows the engine while this is on."
msgstr "Выключено. Пока это включено, системный прокси следует за ядром."

msgid "Proxy mode"
msgstr "Режим прокси"

msgid "Manual points the system at one server. PAC uses a script that Starpod serves."
msgstr "Ручной — система использует один сервер. PAC — скрипт, который раздаёт Starpod."

msgid "Bypass list"
msgstr "Список исключений"

msgid "Hosts the proxy is skipped for, in the operating system's syntax. Used in manual mode."
msgstr "Хосты, для которых прокси пропускается, в синтаксисе операционной системы. Используется в ручном режиме."

msgid "The script for PAC mode. %mixed-port% stands for the engine's mixed port."
msgstr "Скрипт для режима PAC. %mixed-port% означает смешанный порт ядра."

msgid "Terminal"
msgstr "Терминал"

msgid "Proxy command"
msgstr "Команда для прокси"

msgid "Copies the command that points a terminal at Starpod's ports."
msgstr "Копирует команду, которая направляет терминал на порты Starpod."

msgid "Copy proxy command"
msgstr "Копировать команду прокси"

msgid "Adapter"
msgstr "Адаптер"

msgid "Enable TUN"
msgstr "Включить TUN"

msgid "Routes all system traffic. Needs administrator rights."
msgstr "Направляет весь системный трафик. Нужны права администратора."

msgid "Device name"
msgstr "Имя устройства"

msgid "The name of the virtual adapter. Empty uses the engine default."
msgstr "Имя виртуального адаптера. Пусто — значение ядра по умолчанию."

msgid "Automatic"
msgstr "Автоматически"

msgid "MTU"
msgstr "MTU"

msgid "Largest packet size in bytes. Empty uses the engine default."
msgstr "Максимальный размер пакета в байтах. Пусто — значение ядра по умолчанию."

msgid "Stack"
msgstr "Стек"

msgid "How the engine handles the packets that TUN captures."
msgstr "Как ядро обрабатывает пакеты, которые перехватывает TUN."

msgid "Routes"
msgstr "Маршруты"

msgid "Auto route"
msgstr "Авто-маршрут"

msgid "Installs the routes when TUN starts. Off leaves the routes to you."
msgstr "Устанавливает маршруты при запуске TUN. Выключено — маршруты настраиваете вы."

msgid "DNS hijack"
msgstr "Перехват DNS"

msgid "DNS queries to these targets go to the engine, one host:port per line, such as any:53. Empty uses the engine default."
msgstr "DNS-запросы к этим адресам идут в ядро, по одному host:port в строке, например any:53. Пусто — значение ядра по умолчанию."

msgid "Strict route"
msgstr "Строгий маршрут"

msgid "Keeps traffic that is outside the TUN routes from leaving the adapter."
msgstr "Не пускает трафик вне маршрутов TUN через адаптер."

msgid "Auto redirect"
msgstr "Авто-перенаправление"

msgid "Forwards traffic through an automatic redirect where the platform supports one."
msgstr "Перенаправляет трафик через автоматическое перенаправление, где платформа его поддерживает."

msgid "Auto-detect interface"
msgstr "Автоопределение интерфейса"

msgid "Finds the network interface that carries outbound traffic by itself."
msgstr "Само находит сетевой интерфейс, по которому идёт исходящий трафик."

msgid "Endpoint-independent NAT"
msgstr "NAT, не зависящий от конечной точки"

msgid "Keeps one UDP mapping per source port, whatever the destination."
msgstr "Оставляет одно UDP-сопоставление на исходный порт, независимо от адреса назначения."

msgid "Included routes"
msgstr "Включённые маршруты"

msgid "CIDR ranges sent through TUN, one per line. Empty uses the engine's routes."
msgstr "Диапазоны CIDR, которые идут через TUN, по одному в строке. Пусто — маршруты ядра."

msgid "Excluded routes"
msgstr "Исключённые маршруты"

msgid "CIDR ranges that stay off TUN, one per line."
msgstr "Диапазоны CIDR, которые не идут через TUN, по одному в строке."

msgid "DNS server"
msgstr "DNS-сервер"

msgid "Replace the subscription's DNS"
msgstr "Заменить DNS подписки"

msgid "Uses the DNS settings below instead of the ones the subscription sends."
msgstr "Использует настройки DNS ниже вместо тех, что присылает подписка."

msgid "Enable DNS server"
msgstr "Включить DNS-сервер"

msgid "Runs the engine's own DNS server."
msgstr "Запускает собственный DNS-сервер ядра."

msgid "Enhanced mode"
msgstr "Расширенный режим"

msgid "Fake IP answers with addresses from a private range. Redir host answers with real ones."
msgstr "Fake IP отвечает адресами из частного диапазона. Redir host отвечает настоящими адресами."

msgid "Fake IP range"
msgstr "Диапазон Fake IP"

msgid "The CIDR range that fake addresses come from. Empty uses the engine default."
msgstr "Диапазон CIDR, из которого берутся фиктивные адреса. Пусто — значение ядра по умолчанию."

msgid "Fake IP filter"
msgstr "Фильтр Fake IP"

msgid "Domains that always get a real address, one per line."
msgstr "Домены, которые всегда получают настоящий адрес, по одному в строке."

msgid "Upstream servers"
msgstr "Вышестоящие серверы"

msgid "Nameservers"
msgstr "DNS-серверы"

msgid "The servers the DNS server asks, one per line."
msgstr "Серверы, к которым обращается DNS-сервер, по одному в строке."

msgid "Fallback servers"
msgstr "Резервные серверы"

msgid "Servers asked when the nameservers fail, one per line."
msgstr "Серверы, к которым обращаются, если DNS-серверы не отвечают, по одному в строке."

msgid "Default nameservers"
msgstr "DNS-серверы по умолчанию"

msgid "Plain IP servers that resolve the names of the other servers, one per line."
msgstr "Обычные IP-серверы, которые разрешают имена других серверов, по одному в строке."

msgid "Proxy server nameservers"
msgstr "DNS-серверы для прокси"

msgid "Servers used to resolve the names of proxy servers, one per line."
msgstr "Серверы для разрешения имён прокси-серверов, по одному в строке."

msgid "Nameserver policy"
msgstr "Политика DNS-серверов"

msgid "Which servers answer for which domains, one per line: domain: server, server."
msgstr "Какие серверы отвечают за какие домены, по одному в строке: домен: сервер, сервер."

msgid "Hosts"
msgstr "Хосты"

msgid "Use hosts"
msgstr "Использовать hosts"

msgid "Answers names from the hosts list below."
msgstr "Отвечает именами из списка hosts ниже."

msgid "One entry per line: domain ip."
msgstr "Одна запись в строке: домен ip."

msgid "Enable sniffer"
msgstr "Включить сниффер"

msgid "Reads the domain name from the first bytes of TLS and HTTP traffic."
msgstr "Читает доменное имя из первых байт трафика TLS и HTTP."

msgid "Force DNS mapping"
msgstr "Принудительное сопоставление DNS"

msgid "Uses the DNS mapping to name connections that have only an address."
msgstr "Использует сопоставление DNS, чтобы назвать соединения, у которых есть только адрес."

msgid "Parse pure IP"
msgstr "Разбирать чистые IP"

msgid "Sniffs connections that were opened to a bare IP address."
msgstr "Анализирует соединения, открытые по голому IP-адресу."

msgid "Override destination"
msgstr "Подменять адрес назначения"

msgid "Replaces the address with the sniffed domain name."
msgstr "Заменяет адрес перехваченным доменным именем."

msgid "Protocols and domains"
msgstr "Протоколы и домены"

msgid "Sniff protocols"
msgstr "Протоколы для анализа"

msgid "One per line: a protocol and its ports, for example HTTP: 80, 8080-8880."
msgstr "По одному в строке: протокол и его порты, например HTTP: 80, 8080-8880."

msgid "Force domains"
msgstr "Домены для анализа"

msgid "Domains to sniff even when the sniffer would skip them, one per line."
msgstr "Домены, которые анализируются, даже если сниффер их пропустил бы, по одному в строке."

msgid "Skip domains"
msgstr "Пропускаемые домены"

msgid "Domains the sniffer leaves alone, one per line."
msgstr "Домены, которые сниффер не трогает, по одному в строке."

msgid "Databases"
msgstr "Базы данных"

msgid "Format"
msgstr "Формат"

msgid "The database format the engine reads."
msgstr "Формат баз данных, который читает ядро."

msgid "GeoIP source"
msgstr "Источник GeoIP"

msgid "A URL. Empty uses the default source."
msgstr "Адрес. Пусто — источник по умолчанию."

msgid "Default source"
msgstr "Источник по умолчанию"

msgid "GeoSite source"
msgstr "Источник GeoSite"

msgid "MMDB source"
msgstr "Источник MMDB"

msgid "ASN source"
msgstr "Источник ASN"

msgid "Update automatically"
msgstr "Обновлять автоматически"

msgid "Refreshes the databases in the background."
msgstr "Обновляет базы в фоновом режиме."

msgid "Update every"
msgstr "Обновлять каждые"

msgid "Hours between automatic refreshes. Empty uses the app default."
msgstr "Часов между автоматическими обновлениями. Пусто — значение приложения по умолчанию."

msgid "Hours"
msgstr "ч"

msgid "Refresh now"
msgstr "Обновить сейчас"

msgid "Version"
msgstr "Версия"

msgid "Installed"
msgstr "Установлено"

msgid "Not installed"
msgstr "Не установлено"

msgid "Reinstall"
msgstr "Переустановить"

msgid "Install"
msgstr "Установить"

