// The application entry file.
//
// Everything the Rust side needs is exported from here: the window, the
// tray, the Bridge global and the structs the Bridge carries. Rust code is
// generated only for what this file exports (ARCHITECTURE §6.3).
//
// The shell: a top bar with the menu button and the mark, and the active page
// below it at full width, with an optional banner above the page. The
// navigation (the pages, Settings, the status block) is a drawer that is
// closed by default; the menu button slides it in over the page, and choosing
// a page or clicking outside it closes it again.
//
// On a phone (Bridge.mobile) there is no menu button and no drawer. A bottom
// dock holds the main pages instead, as a native app's tab bar does.

import { Design } from "design.slint";
import { Palette } from "std-widgets.slint";
import { Bridge, TextRun } from "bridge.slint";
import { Alert, AlertVariant, ButtonSize, ButtonVariant, ConfirmDialog, IconButton, WindowMetrics, EmojiText } from "primitives.slint";
import { StarpodMark } from "logo.slint";
import { HomePage } from "screens/home.slint";
import { ProfilesPage } from "screens/profiles.slint";
import { ProxiesPage } from "screens/proxies.slint";
import { RulesPage } from "screens/rules.slint";
import { LogsPage } from "screens/logs.slint";
import { SettingsPage } from "screens/settings.slint";
import { ConnectionsPage } from "screens/connections.slint";

export { Bridge, SubscriptionItem, NodeItem, RuleItem, LogItem, SettingsModel, MemberItem, GroupItem, AnnouncementItem, ProfileCardItem, SelectItem, TextRun, WarningItem, HotkeyModel, ConnectionItem } from "bridge.slint";
export { AppTray } from "tray.slint";
export { Design } from "design.slint";

// One row of the sidebar: 36px, 18px icon, 10px gap, 14px label. Icon and
// label are placed on the row's center line, so they share one vertical axis.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback activated();

    private property <bool> hovered: touch.has-hover;

    height: 36px;
    border-radius: Design.radius-md;
    background: root.active ? Design.card-hover
        : root.hovered ? Design.card
        : transparent;

    Image {
        x: 10px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.active ? Design.primary
            : root.hovered ? Design.foreground
            : Design.muted-foreground;
    }

    Text {
        x: 38px;
        y: 0px;
        width: parent.width - 38px - 8px;
        height: parent.height;
        text: root.label;
        color: root.active || root.hovered ? Design.foreground : Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-base;
        font-weight: 500;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// The engine phase as a card at the foot of the sidebar: a colored dot, a
// title and a second line (uptime when running, otherwise the routing mode).
component StatusBlock inherits Rectangle {
    in property <string> phase: "stopped";
    in property <string> uptime: "";
    in property <string> mode: "";
    // A busy message, or the engine error when failed; the detail line shows it.
    in property <string> busy-message: "";
    in property <[TextRun]> busy-message-runs;
    in property <string> error: "";
    in property <[TextRun]> error-runs;

    private property <string> title: root.phase == "running" ? @tr("Connected")
        : root.phase == "starting" ? @tr("Connecting…")
        : root.phase == "stopping" ? @tr("Disconnecting…")
        : root.phase == "failed" ? @tr("Failed")
        : @tr("Not connected");
    private property <string> mode-text: root.mode == "global" ? @tr("Global mode")
        : root.mode == "direct" ? @tr("Direct mode")
        : @tr("Rule mode");
    private property <string> detail: root.busy-message != "" ? root.busy-message
        : root.error != "" ? root.error
        : root.phase == "running" && root.uptime != "" ? @tr("Up {}", root.uptime)
        : root.mode-text;
    private property <[TextRun]> detail-runs: root.busy-message != "" ? root.busy-message-runs : root.error-runs;
    private property <color> dot: root.phase == "running" ? Design.success
        : root.phase == "failed" ? Design.destructive
        : (root.phase == "starting" || root.phase == "stopping") ? Design.warning
        : Design.subtle-foreground;

    height: 56px;
    border-radius: Design.radius-md;
    background: Design.card;

    Rectangle {
        x: 12px;
        y: 15px;
        width: 8px;
        height: 8px;
        border-radius: Design.radius-full;
        background: root.dot;
    }

    Text {
        x: 28px;
        y: 10px;
        width: parent.width - 28px - 12px;
        height: 18px;
        text: root.title;
        color: Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-sm;
        font-weight: 500;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    EmojiText {
        x: 28px;
        y: 28px;
        width: parent.width - 28px - 12px;
        height: 16px;
        runs: root.detail-runs;
        fallback: root.detail;
        color: Design.muted-foreground;
        font-size: Design.font-xs;
        wrap: false;
    }
}

// One row of the More sheet on a phone: a 52px row with the icon and the
// label. The active row is tinted, as a selected drawer row is.
component SheetItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback activated();

    height: 52px;
    border-radius: Design.radius-md;
    background: root.active ? Design.primary-soft : transparent;

    Image {
        x: 12px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.active ? Design.primary : Design.muted-foreground;
    }

    Text {
        x: 46px;
        y: 0px;
        width: parent.width - 46px - 12px;
        height: parent.height;
        text: root.label;
        color: root.active ? Design.foreground : Design.muted-foreground;
        font-family: Design.font-family;
        font-size: 15px;
        font-weight: 500;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

// One tab of the bottom dock on a phone: the icon in a pill when active, and a
// short label under it. The whole item is the touch target, so it is as tall
// as the dock and well over the 48px minimum.
component DockItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback activated();

    horizontal-stretch: 1;
    min-height: 48px;

    // The pill is declared first, so it sits behind the icon.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: 56px;
        height: 28px;
        border-radius: 14px;
        background: root.active ? Design.primary.with-alpha(0.14) : transparent;
        animate background {
            duration: 150ms;
        }
    }

    Image {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.active ? Design.primary : Design.muted-foreground;
    }

    Text {
        x: 0px;
        y: 38px;
        width: parent.width;
        height: 16px;
        text: root.label;
        color: root.active ? Design.foreground : Design.muted-foreground;
        font-family: Design.font-family;
        // 11px is below the smallest design token (12px), as a tab label needs.
        font-size: 11px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

export component AppWindow inherits Window {
    title: "Starpod";
    icon: @image-url("assets/app-icon.png");
    // A tall, narrow window, like a phone-style client.
    min-width: 440px;
    min-height: 640px;
    preferred-width: 480px;
    preferred-height: 840px;
    background: Design.background;

    // Open a page from the sidebar, the dock or the More sheet. Picking the
    // page already open takes it back to its start: Settings to its section
    // list, Profiles out of the profile editor (as Cancel does).
    function go(page: int) {
        if (page == Bridge.active-page) {
            if (page == 5) {
                Bridge.settings-section = -1;
            }
            if (page == 1) {
                Bridge.editor-open = false;
            }
        }
        Bridge.active-page = page;
    }

    // Popups read the window size from WindowMetrics (see Select).
    // The std-widgets (TextEdit, ScrollView, ListView scrollbars) take their
    // colors from this palette. The app is dark only, so they follow it.
    init => {
        Palette.color-scheme = ColorScheme.dark;
        WindowMetrics.width = root.width;
        WindowMetrics.height = root.height;
    }
    changed width => {
        WindowMetrics.width = root.width;
    }
    changed height => {
        WindowMetrics.height = root.height;
    }

    // Whether the navigation drawer is open. It starts closed.
    in-out property <bool> nav-open: false;
    // Whether the More sheet is open on a phone. It starts closed.
    private property <bool> more-open: false;

    VerticalLayout {
        // On a phone the system bars overlap the window: the gesture bar at
        // the bottom, and the status bar, which the top bar extends under.
        // The dock takes the bottom inset itself, so the layout leaves it out
        // on a phone; the inset is then applied exactly once.
        padding-bottom: Bridge.mobile ? 0px : root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;

        // The top bar: the menu button (desktop only), the mark and the name,
        // and the update notice when there is one. On a phone the update
        // notice moves here, because the drawer that holds it is never shown.
        Rectangle {
            height: 52px + root.safe-area-insets.top;
            background: Design.sidebar;

            HorizontalLayout {
                padding-top: root.safe-area-insets.top;
                padding-left: Bridge.mobile ? 16px : 10px;
                padding-right: 16px;
                spacing: 10px;

                // The menu button opens the drawer. A phone has the dock
                // instead, so the button is left out there.
                if (!Bridge.mobile) : VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("assets/icons/menu.svg");
                        size: ButtonSize.md;
                        variant: ButtonVariant.ghost;
                        tooltip: @tr("Menu");
                        clicked => {
                            root.nav-open = true;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    StarpodMark {
                        width: 22px;
                        height: 22px;
                    }
                }

                Text {
                    horizontal-stretch: 0;
                    text: "Starpod";
                    color: Design.foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // The update notice, on a phone only. Tapping it installs the
                // update, as the drawer's copy does on desktop.
                if (Bridge.mobile && Bridge.self-update && Bridge.update-available) : VerticalLayout {
                    alignment: center;

                    // A fixed width keeps the notice from crowding the logo
                    // and the engine state; the text elides if it is longer.
                    Rectangle {
                        width: 180px;
                        height: 28px;
                        border-radius: Design.radius-md;
                        background: update-mobile-ta.has-hover ? Design.card-hover : transparent;

                        Image {
                            x: 6px;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            source: @image-url("assets/icons/download.svg");
                            colorize: Design.primary;
                        }

                        Text {
                            // update-version has no leading "v" (update.rs strips it).
                            x: 26px;
                            y: 0px;
                            width: parent.width - 32px;
                            height: parent.height;
                            text: @tr("Update available: v{}", Bridge.update-version);
                            color: Design.primary;
                            font-family: Design.font-family;
                            font-size: Design.font-xs;
                            font-weight: 500;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }

                        update-mobile-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Bridge.install-update();
                            }
                        }
                    }
                }

                // The engine state, so it is visible with the drawer closed.
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Bridge.engine-phase == "running" ? Design.success
                                : Bridge.engine-phase == "failed" ? Design.destructive
                                : Design.subtle-foreground;
                        }
                    }

                    Text {
                        text: Bridge.engine-phase == "running" ? @tr("Connected")
                            : Bridge.engine-phase == "failed" ? @tr("Failed")
                            : Bridge.engine-phase == "starting" ? @tr("Connecting…")
                            : Bridge.engine-phase == "stopping" ? @tr("Disconnecting…")
                            : @tr("Not connected");
                        color: Design.muted-foreground;
                        font-family: Design.font-family;
                        font-size: Design.font-sm;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                }
            }
        }

        // The hairline under the top bar.
        Rectangle {
            height: 1px;
            background: Design.border;
        }

        // The content area: the banner, then the active page. Each page scrolls
        // by itself, so the banner stays put.
        VerticalLayout {
            horizontal-stretch: 1;
            // Takes the height that the dock leaves, so the page ends above it.
            vertical-stretch: 1;

            if (Bridge.banner-message != "") : HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                padding-top: 20px;

                Alert {
                    horizontal-stretch: 1;
                    variant: Bridge.banner-kind == "error" ? AlertVariant.error
                        : Bridge.banner-kind == "success" ? AlertVariant.success
                        : AlertVariant.info;
                    text: Bridge.banner-message;
                    text-runs: Bridge.banner-runs;
                    closable: true;
                    dismissed => {
                        Bridge.dismiss-banner();
                    }
                }
            }

            if (Bridge.active-page == 0) : HomePage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 1) : ProfilesPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 2) : ProxiesPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 3) : RulesPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 4) : LogsPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 5) : SettingsPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
            if (Bridge.active-page == 6) : ConnectionsPage {
                horizontal-stretch: 1;
                vertical-stretch: 1;
            }
        }

        // The bottom dock, on a phone only. It is the last child, so it sits
        // under the content. Its height includes the gesture bar inset, so the
        // background runs under the bar while the tabs stay above it.
        if (Bridge.mobile) : Rectangle {
            height: 64px + root.safe-area-insets.bottom;
            background: Design.sidebar;

            HorizontalLayout {
                y: 0px;
                height: 64px;

                // The tabs: Home, Profiles, Proxies and Settings, then More. More
                // opens a sheet with the pages that do not fit in the dock
                // (Connections, Rules and Logs), so every page stays reachable.
                DockItem {
                    label: @tr("Home");
                    icon: @image-url("assets/icons/house.svg");
                    active: Bridge.active-page == 0;
                    activated => {
                        root.go(0);
                    }
                }

                DockItem {
                    label: @tr("Profiles");
                    icon: @image-url("assets/icons/layers.svg");
                    active: Bridge.active-page == 1;
                    activated => {
                        root.go(1);
                    }
                }

                DockItem {
                    label: @tr("Proxies");
                    icon: @image-url("assets/icons/server.svg");
                    active: Bridge.active-page == 2;
                    activated => {
                        root.go(2);
                    }
                }

                DockItem {
                    label: @tr("Settings");
                    icon: @image-url("assets/icons/settings.svg");
                    active: Bridge.active-page == 5;
                    activated => {
                        root.go(5);
                    }
                }

                // The tab is lit while one of the sheet's pages is the active one,
                // so the user can see where they are.
                DockItem {
                    label: @tr("More");
                    icon: @image-url("assets/icons/menu.svg");
                    active: Bridge.active-page == 3 || Bridge.active-page == 4 || Bridge.active-page == 6;
                    activated => {
                        root.more-open = true;
                    }
                }
            }

            // The hairline on the dock's top edge.
            Rectangle {
                y: 0px;
                height: 1px;
                background: Design.border;
            }
        }
    }

    // The backdrop behind the open drawer. A click on it closes the drawer.
    // A phone has no drawer, so there is no backdrop either.
    if (root.nav-open && !Bridge.mobile) : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000099;

        TouchArea {
            clicked => {
                root.nav-open = false;
            }
        }
    }

    // The navigation drawer: 240px, sliding in from the left over the page.
    drawer := Rectangle {
        x: root.nav-open ? 0px : -self.width - 2px;
        y: 0px;
        width: 240px + root.safe-area-insets.left;
        height: root.height;
        background: Design.sidebar;
        // On a phone the dock replaces the drawer, so the drawer is never shown.
        visible: !Bridge.mobile;
        animate x {
            duration: 180ms;
            easing: ease-out;
        }

        // Swallows clicks, so they do not reach the backdrop or the page.
        TouchArea { }

        // The hairline on the drawer's edge.
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: Design.border;
        }

        VerticalLayout {
            padding: 12px;
            padding-top: 8px + root.safe-area-insets.top;
            padding-left: 12px + root.safe-area-insets.left;
            spacing: 0px;

            // The brand row, with the button that closes the drawer at the
            // same place as the one that opened it.
            HorizontalLayout {
                height: 44px;
                spacing: 10px;
                padding-left: -2px;

                VerticalLayout {
                    alignment: center;

                    IconButton {
                        icon: @image-url("assets/icons/x.svg");
                        size: ButtonSize.md;
                        variant: ButtonVariant.ghost;
                        tooltip: @tr("Close menu");
                        clicked => {
                            root.nav-open = false;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    StarpodMark {
                        width: 22px;
                        height: 22px;
                    }
                }

                Text {
                    text: "Starpod";
                    color: Design.foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-lg;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

                VerticalLayout {
                    padding-top: 12px;
                    spacing: 4px;

                    NavItem {
                        label: @tr("Home");
                        icon: @image-url("assets/icons/house.svg");
                        active: Bridge.active-page == 0;
                        activated => {
                            root.go(0);
                            root.nav-open = false;
                        }
                    }

                    NavItem {
                        label: @tr("Profiles");
                        icon: @image-url("assets/icons/layers.svg");
                        active: Bridge.active-page == 1;
                        activated => {
                            root.go(1);
                            root.nav-open = false;
                        }
                    }

                    NavItem {
                        label: @tr("Proxies");
                        icon: @image-url("assets/icons/server.svg");
                        active: Bridge.active-page == 2;
                        activated => {
                            root.go(2);
                            root.nav-open = false;
                        }
                    }

                    NavItem {
                        label: @tr("Rules");
                        icon: @image-url("assets/icons/route.svg");
                        active: Bridge.active-page == 3;
                        activated => {
                            root.go(3);
                            root.nav-open = false;
                        }
                    }

                    NavItem {
                        label: @tr("Logs");
                        icon: @image-url("assets/icons/scroll-text.svg");
                        active: Bridge.active-page == 4;
                        activated => {
                            root.go(4);
                            root.nav-open = false;
                        }
                    }

                    NavItem {
                        label: @tr("Connections");
                        icon: @image-url("assets/icons/activity.svg");
                        active: Bridge.active-page == 6;
                        activated => {
                            root.go(6);
                            root.nav-open = false;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                VerticalLayout {
                    spacing: 4px;
                    padding-bottom: 8px;

                    NavItem {
                        label: @tr("Settings");
                        icon: @image-url("assets/icons/settings.svg");
                        active: Bridge.active-page == 5;
                        activated => {
                            root.go(5);
                            root.nav-open = false;
                        }
                    }

                    if (Bridge.self-update && Bridge.update-available) : Rectangle {
                        height: 28px;
                        border-radius: Design.radius-md;
                        background: update-ta.has-hover ? Design.card-hover : transparent;

                        HorizontalLayout {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            spacing: 8px;

                            // A horizontal layout would pin the icon to the top of the row;
                            // centering it vertically puts it on the text's center line.
                            VerticalLayout {
                                alignment: center;

                                Image {
                                    width: 14px;
                                    height: 14px;
                                    source: @image-url("assets/icons/download.svg");
                                    colorize: Design.primary;
                                }
                            }

                            EmojiText {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                // update-version has no leading "v" (update.rs strips it).
                                fallback: @tr("Update available: v{}", Bridge.update-version);
                                color: Design.primary;
                                font-size: Design.font-xs;
                                font-weight: 500;
                                wrap: false;
                            }
                        }

                        update-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Bridge.install-update();
                            }
                        }
                    }

                    StatusBlock {
                        phase: Bridge.engine-phase;
                        uptime: Bridge.uptime;
                        mode: Bridge.mode;
                        busy-message: Bridge.busy ? Bridge.busy-message : "";
                        busy-message-runs: Bridge.busy-message-runs;
                        error: Bridge.engine-phase == "failed" ? Bridge.engine-error : "";
                        error-runs: Bridge.engine-error-runs;
                    }
                }
        }
    }

    // The More sheet, on a phone only: the pages that the dock does not hold,
    // in a panel that rises above the dock. The scrim behind it covers the
    // whole window, and tapping it closes the sheet.
    if (root.more-open && Bridge.mobile) : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000080;

        TouchArea {
            clicked => {
                root.more-open = false;
            }
        }
    }

    more-sheet := Rectangle {
        // The panel rests on top of the dock, and slides up from below the
        // window when it opens.
        x: 0px;
        y: root.more-open ? root.height - (64px + root.safe-area-insets.bottom) - self.height : root.height;
        width: root.width;
        height: 172px;
        opacity: root.more-open ? 1 : 0;
        visible: Bridge.mobile;
        background: Design.popover;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        border-width: 1px;
        border-color: Design.border;
        animate y {
            duration: 180ms;
            easing: ease-out;
        }
        animate opacity {
            duration: 180ms;
            easing: ease-out;
        }

        // Swallows clicks, so they do not reach the scrim.
        TouchArea { }

        VerticalLayout {
            padding: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            SheetItem {
                label: @tr("Connections");
                icon: @image-url("assets/icons/activity.svg");
                active: Bridge.active-page == 6;
                activated => {
                    root.go(6);
                    root.more-open = false;
                }
            }

            SheetItem {
                label: @tr("Rules");
                icon: @image-url("assets/icons/route.svg");
                active: Bridge.active-page == 3;
                activated => {
                    root.go(3);
                    root.more-open = false;
                }
            }

            SheetItem {
                label: @tr("Logs");
                icon: @image-url("assets/icons/scroll-text.svg");
                active: Bridge.active-page == 4;
                activated => {
                    root.go(4);
                    root.more-open = false;
                }
            }
        }
    }

    // The confirmation for a starpod:// link. It opens only when Rust sets
    // install-pending, and it adds nothing until the user confirms.
    private property <bool> install-mirror: Bridge.install-pending;
    changed install-mirror => {
        if (install-mirror) {
            install-dialog.show();
        } else {
            install-dialog.close();
        }
    }

    install-dialog := ConfirmDialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Add subscription?");
        message: (Bridge.install-name == "" ? @tr("Add the subscription from {}?", Bridge.install-host) : @tr("Add the subscription from {}?\nName: {}", Bridge.install-host, Bridge.install-name))
            
            + (Bridge.install-error == "" ? "" : "\n\n" + Bridge.install-error);
        confirm-text: @tr("Add");
        confirm-variant: ButtonVariant.primary;
        busy: Bridge.busy;
        confirmed => {
            Bridge.confirm-install();
        }
        canceled => {
            Bridge.cancel-install();
        }
    }

    // The update prompt, shown on every start that finds a newer release.
    // Download starts the install (which restarts Starpod); Later only closes
    // it for this run. Either way Rust's flag is cleared, so the next check
    // can open it again.
    private property <bool> update-mirror: Bridge.update-prompt;
    changed update-mirror => {
        if (update-mirror) {
            update-dialog.show();
        } else {
            update-dialog.close();
        }
    }

    update-dialog := ConfirmDialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Starpod {} is available", Bridge.update-version);
        message: @tr("Installing it restarts Starpod. You can update later from Settings.");
        confirm-text: @tr("Download");
        confirm-variant: ButtonVariant.primary;
        cancel-text: @tr("Later");
        confirmed => {
            Bridge.update-prompt = false;
            Bridge.install-update();
        }
        canceled => {
            Bridge.update-prompt = false;
        }
    }
}
