// The primitives.
//
// Every screen is built from these. They carry the foxgirls treatments:
// the card's *ring* rather than a border, the button's brand-red focus
// halo, and the badge pill.
//
// A primitive is presentational only. It has no business logic — a
// component that needs to know something calls a callback, and the
// handler lives in `starpod-app` (ARCHITECTURE §6.3).
//
// Two Slint 1.18 rules shape this file:
//
// - There is no element-level `else`. A conditional element is
//   `if (condition) : Element { }` and nothing else, so a two-way choice
//   is two conditional elements, or one element whose *contents* are
//   chosen by a binding.
// - `Tooltip` is a child element of the thing it describes, not a
//   wrapper. `TooltipArea` is the compiler's internal machinery.

import { Design } from "design.slint";
import { IconCheck, IconChevronDown, IconRefreshCw, IconTriangleAlert, IconX } from "icons.slint";

// ---------------------------------------------------------------------------
// Button
// ---------------------------------------------------------------------------

export enum ButtonVariant {
    default,
    outline,
    secondary,
    ghost,
    destructive,
}

export enum ButtonSize {
    sm,
    md,
    lg,
}

// Heights 28 / 32 / 36px. The width hugs the label: text plus the side
// padding (10 / 12 / 16px), so a caller that sets no width gets a button
// that fits its words. A busy button makes room for the spinner on the left.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <ButtonVariant> variant: ButtonVariant.default;
    in property <ButtonSize> size: ButtonSize.md;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <string> busy-text;
    /// The reason the button is disabled, shown as a tooltip.
    ///
    /// GOAL.md §5 requires that an unavailable control be *visibly
    /// disabled with a reason*, not silently inert. The tooltip is where
    /// the reason goes.
    in property <string> disabled-reason;
    callback clicked();

    private property <length> pad-x: root.size == ButtonSize.sm ? 10px
        : root.size == ButtonSize.lg ? 16px : 12px;
    private property <length> spinner-room: root.busy ? 22px : 0px;

    background: variant == ButtonVariant.default ? Design.primary
        : variant == ButtonVariant.outline ? Design.background
        : variant == ButtonVariant.secondary ? Design.secondary
        : variant == ButtonVariant.destructive ? Design.destructive
        : transparent;

    border-width: variant == ButtonVariant.outline ? 1px : 0px;
    border-color: Design.input;

    border-radius: Design.radius-lg;
    opacity: enabled ? 1 : 0.5;

    height: size == ButtonSize.sm ? 28px : size == ButtonSize.lg ? 36px : 32px;
    width: label.preferred-width + 2 * root.pad-x + root.spinner-room;

    // The focus ring: a brand-red halo at half strength, the site's
    // `focus-visible:ring-3 ring-ring/50`.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Design.radius-lg + 3px;
        border-width: 3px;
        border-color: Design.ring;
        opacity: 0.5;
        visible: focus-scope.has-focus;
    }

    // The label. It fills the button's width minus any spinner room and is
    // centred in that space on both axes.
    label := Text {
        x: root.spinner-room;
        width: root.width - root.spinner-room;
        height: root.height;
        text: root.busy && root.busy-text != "" ? root.busy-text : root.text;
        color: root.variant == ButtonVariant.default ? Design.primary-foreground
            : root.variant == ButtonVariant.destructive ? Design.primary-foreground
            : Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    // A spinner, shown while the button is busy.
    if (root.busy) : IconRefreshCw {
        width: 14px;
        height: 14px;
        x: root.pad-x;
        y: (root.height - 14px) / 2;
        stroke: root.variant == ButtonVariant.default || root.variant == ButtonVariant.destructive
            ? Design.primary-foreground
            : Design.foreground;
        stroke-width: 2px;
        opacity: 0.7;
    }

    // The disabled reason, as a tooltip on the button itself.
    if (!root.enabled && root.disabled-reason != "") : Tooltip {
        text: @markdown("\{root.disabled-reason}");
    }

    // The focus scope and the touch area. They are separate elements
    // because `has-focus` belongs to the `FocusScope`, not to the
    // rectangle the button is drawn with.
    focus-scope := FocusScope {
        focus-on-click: true;

        touch := TouchArea {
            enabled: root.enabled && !root.busy;
            clicked => {
                root.clicked();
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Card
// ---------------------------------------------------------------------------

export component Card inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> show-header: title != "";

    background: Design.card;
    border-radius: Design.radius-xl;
    // The site uses a *ring* on cards, not a border: a 1px inner line at
    // 10% foreground.
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);

    VerticalLayout {
        padding: Design.space-lg;
        spacing: Design.space-md;

        if (root.show-header) : VerticalLayout {
            spacing: 2px;

            Text {
                text: root.title;
                color: Design.foreground;
                font-family: Design.font-family;
                font-size: Design.font-md;
                font-weight: 500;
                wrap: word-wrap;
            }

            if (root.description != "") : Text {
                text: root.description;
                color: Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                wrap: word-wrap;
            }
        }

        @children
    }
}

// ---------------------------------------------------------------------------
// Badge
// ---------------------------------------------------------------------------

export enum BadgeVariant {
    default,
    secondary,
    destructive,
    outline,
    success,
    warning,
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeVariant> variant: BadgeVariant.secondary;

    height: 20px;
    border-radius: 10px;

    background: variant == BadgeVariant.default ? Design.primary
        : variant == BadgeVariant.destructive ? Design.destructive
        : variant == BadgeVariant.success ? Design.success
        : variant == BadgeVariant.warning ? Design.warning
        : variant == BadgeVariant.secondary ? Design.secondary
        : transparent;

    border-width: variant == BadgeVariant.outline ? 1px : 0px;
    border-color: Design.input;

    Text {
        text: root.text;
        color: root.variant == BadgeVariant.default || root.variant == BadgeVariant.destructive
            ? Design.primary-foreground
            : Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
    }
}

// ---------------------------------------------------------------------------
// Status dot
// ---------------------------------------------------------------------------

export enum StatusKind {
    running,
    stopped,
    error,
    syncing,
}

// A fixed 10px dot. It takes no stretch, so a layout that centres it
// (a VerticalLayout with `alignment: center`) places it on the text's
// middle line; it carries no offset of its own.
export component StatusDot inherits Rectangle {
    in property <StatusKind> kind: StatusKind.stopped;

    width: 10px;
    height: 10px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 5px;

    background: kind == StatusKind.running ? Design.primary
        : kind == StatusKind.error ? Design.destructive
        : transparent;

    border-width: kind == StatusKind.running || kind == StatusKind.error ? 0px : 1.5px;
    border-color: Design.muted-foreground;

    // The syncing dot pulses at reduced opacity, the site's
    // `prefers-reduced-motion` guarded animation. The pulse is a
    // repeating timer that drives the opacity between two values.
    opacity: kind == StatusKind.syncing ? pulse : 1;
    animate opacity { duration: 900ms; }

    // Private, so that the pulse is an internal detail of the dot and
    // not something the surrounding UI can set.
    private property <float> pulse: 0.45;

    Timer {
        interval: 900ms;
        running: root.kind == StatusKind.syncing;
        triggered => {
            root.pulse = root.pulse < 0.6 ? 0.85 : 0.45;
        }
    }
}

// ---------------------------------------------------------------------------
// Field
//
// A labelled text box: the label sits above the box (12px, muted), the box
// is 36px high with a 1px input border and 12px side padding, and the value
// or placeholder is vertically centred. An error sits below the box.
// An empty `label` renders no label row.
// ---------------------------------------------------------------------------

export enum FieldKind {
    text,
    password,
    number,
    combo,
}

export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    // Two-way: the TextInput writes into it, so a screen can read the value
    // and reset it (bind with `<=>`).
    in-out property <string> value;
    in property <FieldKind> kind: FieldKind.text;
    in property <bool> enabled: true;
    in property <string> error;
    /// The choices for a combo field.
    in property <[string]> choices;
    /// The index of the selected choice.
    in property <int> selected-index: 0;
    in property <bool> read-only: false;
    callback edited(string);
    callback selected(int);

    spacing: Design.space-xs;
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 6px;
        vertical-stretch: 0;

        if (root.label != "") : Text {
            text: root.label;
            color: Design.muted-foreground;
            font-family: Design.font-family;
            font-size: Design.font-xs;
            wrap: no-wrap;
        }

        box := Rectangle {
            height: 36px;
            vertical-stretch: 0;
            background: Design.background;
            border-radius: Design.radius-md;
            border-width: 1px;
            border-color: root.error != "" ? Design.destructive : Design.input;

            // The focus ring: the same halo the buttons use, in Design.ring.
            Rectangle {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                border-radius: Design.radius-md + 3px;
                border-width: 3px;
                border-color: Design.ring;
                opacity: 0.5;
                visible: input.has-focus;
            }

            // The combo: a read-only value chosen from a list.
            if (root.kind == FieldKind.combo) : Text {
                x: Design.space-md;
                width: parent.width - 2 * Design.space-md - 24px;
                height: parent.height;
                text: root.selected-index >= 0 && root.selected-index < root.choices.length
                    ? root.choices[root.selected-index] : "";
                color: root.enabled ? Design.foreground : Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            if (root.kind == FieldKind.combo) : IconChevronDown {
                width: 16px;
                height: 16px;
                x: parent.width - 12px - 16px;
                y: (parent.height - self.height) / 2;
                stroke: Design.muted-foreground;
                stroke-width: 2px;
            }

            if (root.kind == FieldKind.combo) : TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.selected(root.selected-index);
                }
            }

            // Everything that is not a combo is a plain input.
            //
            // `TextInput` has no placeholder property in Slint 1.18, so
            // the hint is a separate `Text` that is only visible while
            // the input is empty.
            if (root.kind != FieldKind.combo && root.value == "") : Text {
                x: Design.space-md;
                width: parent.width - 2 * Design.space-md;
                height: parent.height;
                text: root.placeholder;
                color: Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            input := TextInput {
                visible: root.kind != FieldKind.combo;
                x: Design.space-md;
                width: parent.width - 2 * Design.space-md;
                height: parent.height;
                color: root.enabled ? Design.foreground : Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                vertical-alignment: center;
                input-type: root.kind == FieldKind.password ? InputType.password
                    : root.kind == FieldKind.number ? InputType.number : InputType.text;
                read-only: root.read-only;
                enabled: root.enabled;
                text <=> root.value;

                edited => {
                    root.edited(self.text);
                }
            }
        }
    }

    if (root.error != "") : Text {
        text: root.error;
        color: Design.destructive;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------------------
// Select
//
// The same box as Field, showing the chosen value vertically centred with a
// 16px chevron 12px from the right edge. A click opens a themed list in a
// PopupWindow below the box: rows are 32px, hover uses Design.accent, and the
// chosen row carries a check.
//
// The component never writes `value`. The caller owns it: bind it with
// `value: ...` (or `<=>` to a property the caller writes), and set it again
// in `selected(v)`. That keeps a binding to a struct field intact.
// ---------------------------------------------------------------------------

export component AppSelect inherits VerticalLayout {
    in property <[string]> options;
    in-out property <string> value;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback selected(string);

    spacing: 6px;
    vertical-stretch: 0;

    if (root.label != "") : Text {
        text: root.label;
        color: Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        wrap: no-wrap;
    }

    box := Rectangle {
        height: 36px;
        vertical-stretch: 0;
        background: Design.background;
        border-radius: Design.radius-md;
        border-width: 1px;
        border-color: popup.is-open ? Design.ring : Design.input;
        opacity: root.enabled ? 1 : 0.5;

        Text {
            x: Design.space-md;
            width: parent.width - 2 * Design.space-md - 16px - Design.space-sm;
            height: parent.height;
            text: root.value != "" ? root.value : root.placeholder;
            color: root.value != "" ? Design.foreground : Design.muted-foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }

        IconChevronDown {
            width: 16px;
            height: 16px;
            x: parent.width - 12px - 16px;
            y: (parent.height - self.height) / 2;
            stroke: Design.muted-foreground;
            stroke-width: 2px;
        }

        TouchArea {
            enabled: root.enabled;
            clicked => {
                popup.show();
            }
        }

        popup := PopupWindow {
            x: 0;
            y: box.height + 4px;
            width: box.width;
            height: root.options.length * 32px + 8px;
            close-policy: close-on-click-outside;

            Rectangle {
                background: Design.popover;
                border-radius: Design.radius-md;
                border-width: 1px;
                border-color: Design.input;

                VerticalLayout {
                    padding: 4px;
                    spacing: 0px;

                    for option[i] in root.options : Rectangle {
                        height: 32px;
                        border-radius: Design.radius-sm;
                        background: option-touch.has-hover ? Design.accent : transparent;

                        Text {
                            x: Design.space-sm;
                            width: parent.width - 2 * Design.space-sm - 16px - Design.space-sm;
                            height: parent.height;
                            text: option;
                            color: Design.foreground;
                            font-family: Design.font-family;
                            font-size: Design.font-sm;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                        }

                        if (option == root.value) : IconCheck {
                            width: 16px;
                            height: 16px;
                            x: parent.width - 16px - Design.space-sm;
                            y: (parent.height - self.height) / 2;
                            stroke: Design.foreground;
                            stroke-width: 2px;
                        }

                        option-touch := TouchArea {
                            clicked => {
                                root.selected(option);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Section header
// ---------------------------------------------------------------------------

export component SectionHeading inherits VerticalLayout {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> description;

    spacing: 2px;

    if (root.eyebrow != "") : Text {
        text: root.eyebrow;
        color: Design.primary;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        font-weight: 500;
    }

    Text {
        text: root.title;
        color: Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-xl;
        font-weight: 600;
        wrap: word-wrap;
    }

    if (root.description != "") : Text {
        text: root.description;
        color: Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-sm;
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------------------
// Empty state
//
// GOAL.md §5 requires every screen to have an explicit empty state — no
// blank panels. It takes its natural height (no stretch), so inside a card
// it is a compact centred block, not an empty box.
// ---------------------------------------------------------------------------

export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    callback action();

    spacing: Design.space-xs;
    alignment: center;
    vertical-stretch: 0;
    padding-top: Design.space-sm;
    padding-bottom: Design.space-sm;

    Text {
        text: root.title;
        color: Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-sm;
        font-weight: 500;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if (root.description != "") : Text {
        text: root.description;
        color: Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if (root.action-text != "") : AppButton {
        text: root.action-text;
        clicked => {
            root.action();
        }
    }
}

// ---------------------------------------------------------------------------
// Error banner
// ---------------------------------------------------------------------------

export enum BannerKind {
    info,
    success,
    error,
}

export component ErrorBanner inherits Rectangle {
    in property <string> message;
    in property <string> detail;
    in property <BannerKind> kind: BannerKind.error;
    callback dismissed();

    private property <color> ink: root.kind == BannerKind.error ? Design.primary-foreground : Design.foreground;

    background: root.kind == BannerKind.error ? Design.destructive
        : root.kind == BannerKind.success ? Design.success
        : Design.secondary;
    border-radius: Design.radius-md;
    border-width: root.kind == BannerKind.info ? 1px : 0px;
    border-color: Design.input;
    min-height: 44px;

    HorizontalLayout {
        padding: Design.space-sm;
        padding-left: Design.space-md;
        spacing: Design.space-sm;

        IconTriangleAlert {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            stroke: root.ink;
            stroke-width: 2px;
            visible: root.kind == BannerKind.error;
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;

            Text {
                text: root.message;
                color: root.ink;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                font-weight: 500;
                wrap: word-wrap;
            }

            if (root.detail != "") : Text {
                text: root.detail;
                color: root.ink;
                font-family: Design.font-family;
                font-size: Design.font-xs;
                opacity: 0.85;
                wrap: word-wrap;
            }
        }

        // The dismiss control: an icon with a hit area, not a glyph in a
        // text label.
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: Design.radius-sm;

            IconX {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: root.ink;
                stroke-width: 2px;
            }

            TouchArea {
                clicked => {
                    root.dismissed();
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Loading state
// ---------------------------------------------------------------------------

export component LoadingState inherits VerticalLayout {
    in property <string> message: "Loading…";

    spacing: Design.space-sm;
    alignment: center;

    Text {
        text: root.message;
        color: Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-sm;
    }
}

// ---------------------------------------------------------------------------
// Labelled row
//
// The shape most of the Settings screen is made of: a label, a control, and
// an optional explanation underneath.
// ---------------------------------------------------------------------------

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;

    height: 60px;

    VerticalLayout {
        spacing: 2px;

        Text {
            text: root.label;
            color: Design.foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            font-weight: 500;
            wrap: word-wrap;
        }

        if (root.description != "") : Text {
            text: root.description;
            color: Design.muted-foreground;
            font-family: Design.font-family;
            font-size: Design.font-xs;
            wrap: word-wrap;
        }
    }
}
