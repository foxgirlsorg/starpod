// The UI primitives: the small components every page is built from.
//
// They follow docs/design/ui-spec.md section 3. A page never draws a button,
// an input or a card by hand; it composes these. Icons are passed as `image`
// properties (`@image-url("assets/icons/x.svg")`) and tinted with `colorize`,
// so one component serves every icon.
//
// Common rules for every interactive primitive: disabled means opacity 0.5
// and no hover; there is no focus ring, keyboard or mouse (Space and Enter
// still work on a focused control); clickable things show a pointer cursor.

import { Design } from "design.slint";
import { ListView, ScrollView } from "std-widgets.slint";
// `SelectItem` lives in bridge.slint, where the Rust side builds it; it is
// re-exported here so the pages that import it from this file still compile.
import { SelectItem, TextRun } from "bridge.slint";
export { SelectItem }
// EmojiText draws a string with its emoji as pictures (see emoji-text.slint).
import { EmojiText } from "emoji-text.slint";
export { EmojiText }

// --- shared enums and structs -----------------------------------------------

export enum ButtonVariant { primary, secondary, outline, ghost, destructive, destructive-outline }
export enum ButtonSize { sm, md, lg }
export enum BadgeVariant { neutral, primary, success, warning, destructive, outline }
export enum AlertVariant { info, error, success, warning }

// The latency color and text rules, shared by LatencyText and Select items.
// -1 = untested, 0 = timeout, otherwise milliseconds.
export global LatencyFormat {
    public pure function latency-color(ms: int) -> color {
        if (ms < 0) {
            return Design.subtle-foreground;
        }
        if (ms == 0) {
            return Design.destructive;
        }
        if (ms < 200) {
            return Design.success;
        }
        if (ms < 500) {
            return Design.warning;
        }
        return Design.destructive;
    }

    public pure function latency-text(ms: int) -> string {
        if (ms < 0) {
            return "—";
        }
        if (ms == 0) {
            return @tr("timeout");
        }
        return ms + @tr(" ms");
    }
}

// The size of the application window, kept up to date by app.slint. Popups
// read it to decide whether they open below or above their box.
export global WindowMetrics {
    in-out property <length> width: 0px;
    in-out property <length> height: 0px;
}

// --- Spinner ----------------------------------------------------------------

// A rotating ring, one turn every 800 ms. Only instantiate it while busy:
// the timer runs for as long as the element exists.
export component Spinner inherits Rectangle {
    in property <length> size: 16px;
    in property <color> tint: Design.primary;

    private property <angle> turn: 0deg;

    width: root.size;
    height: root.size;

    Timer {
        // 9 degrees every 20 ms is 360 degrees every 800 ms.
        interval: 20ms;
        running: true;
        triggered => {
            root.turn += 9deg;
        }
    }

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("assets/icons/loader-circle.svg");
        colorize: root.tint;
        transform-rotation: root.turn;
    }
}

// --- Button -----------------------------------------------------------------

// A text button with an optional leading icon. Its width is its content unless
// the parent stretches it (horizontal-stretch: 1). Set `busy` to replace the
// icon with a spinner; a busy button ignores clicks.
export component Button inherits Rectangle {
    in property <string> text;
    in property <ButtonVariant> variant: ButtonVariant.primary;
    in property <ButtonSize> size: ButtonSize.md;
    in property <image> icon;
    in property <bool> busy: false;
    in property <bool> enabled: true;
    callback clicked();

    private property <bool> live: root.enabled && !root.busy;
    private property <bool> hovered: ta.has-hover && root.live;
    private property <length> pad: root.size == ButtonSize.sm ? 10px
        : root.size == ButtonSize.md ? 16px : 24px;
    private property <length> label-size: root.size == ButtonSize.sm ? 13px
        : root.size == ButtonSize.md ? 14px : 15px;
    private property <bool> has-lead: root.busy || root.icon.width > 0;
    private property <length> lead-w: root.has-lead ? 16px : 0px;
    private property <length> gap: root.has-lead ? 8px : 0px;
    private property <length> content-w: root.lead-w + root.gap + label.preferred-width;

    // White on the filled primary and destructive buttons, red on
    // destructive-outline, the normal foreground otherwise.
    private property <color> ink: (root.variant == ButtonVariant.primary || root.variant == ButtonVariant.destructive)
        ? Design.primary-foreground
        : root.variant == ButtonVariant.destructive-outline ? Design.destructive
        : Design.foreground;

    height: root.size == ButtonSize.sm ? 28px
        : root.size == ButtonSize.md ? 36px : 44px;
    preferred-width: root.pad * 2 + root.content-w;
    // Content width unless the parent stretches it.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Design.radius-md;
    background: root.variant == ButtonVariant.primary
            ? (root.hovered ? (ta.pressed ? Design.primary-pressed : Design.primary-hover) : Design.primary)
        : root.variant == ButtonVariant.secondary
            ? (root.hovered ? Design.secondary-hover : Design.secondary)
        : root.variant == ButtonVariant.destructive
            ? (root.hovered ? Design.destructive.brighter(0.15) : Design.destructive)
        : root.variant == ButtonVariant.destructive-outline
            ? (root.hovered ? Design.destructive.with-alpha(0.1) : transparent)
        : (root.hovered ? Design.accent : transparent);
    border-width: root.variant == ButtonVariant.outline || root.variant == ButtonVariant.destructive-outline ? 1px : 0px;
    border-color: root.variant == ButtonVariant.destructive-outline ? Design.destructive.with-alpha(0.5) : Design.input;
    opacity: root.enabled ? 1 : 0.5;

    // Focus ring: 2px wide, 2px outside the edge.
    if (root.busy) : Spinner {
        x: (root.width - root.content-w) / 2;
        y: (root.height - 16px) / 2;
        size: 16px;
        tint: root.ink;
    }

    if (!root.busy && root.icon.width > 0) : Image {
        x: (root.width - root.content-w) / 2;
        y: (root.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.ink;
    }

    label := Text {
        x: (root.width - root.content-w) / 2 + root.lead-w + root.gap;
        width: self.preferred-width;
        height: root.height;
        text: root.text;
        color: root.ink;
        font-family: Design.font-family;
        font-size: root.label-size;
        font-weight: 500;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    fs := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (root.live && (event.text == " " || event.text == "\n")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// --- IconButton -------------------------------------------------------------

// A square icon-only button: 28, 36 or 44 px. `variant` is ghost (default) or
// outline. `tooltip` shows after 500 ms of hover.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <ButtonVariant> variant: ButtonVariant.ghost;
    in property <ButtonSize> size: ButtonSize.md;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();

    private property <bool> live: root.enabled;
    private property <bool> hovered: ta.has-hover && root.live;

    width: root.size == ButtonSize.sm ? 28px
        : root.size == ButtonSize.md ? 36px : 44px;
    height: self.width;
    border-radius: Design.radius-md;
    background: root.hovered ? Design.accent : transparent;
    border-width: root.variant == ButtonVariant.outline ? 1px : 0px;
    border-color: Design.input;
    opacity: root.enabled ? 1 : 0.5;

    Image {
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.hovered ? Design.foreground : Design.muted-foreground;
    }

    if (root.tooltip != "") : Tooltip {
        text: @markdown("\{root.tooltip}");
    }

    fs := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (root.live && (event.text == " " || event.text == "\n")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// --- Input ------------------------------------------------------------------

// A single-line text field, 36px tall. `label` sits above it, `error` (red)
// or `hint` (muted) below it. `icon` is an optional leading 16px icon (for a
// search field). `secret` hides the text; `numeric` opens a number keyboard.
export component Input inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <string> error;
    in property <string> hint;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> secret: false;
    in property <bool> numeric: false;
    callback edited(string);
    callback accepted(string);

    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: col.preferred-height;

    col := VerticalLayout {
        spacing: 8px;

        if (root.label != "") : Text {
            text: root.label;
            color: Design.foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            font-weight: 500;
            height: 16px;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            field := Rectangle {
                height: 36px;
                border-radius: Design.radius-md;
                border-width: 1px;
                border-color: input-field.has-focus ? Design.ring
                    : (root.error != "" ? Design.destructive : Design.input);
                background: transparent;
                opacity: root.enabled ? 1 : 0.5;

                if (root.icon.width > 0) : Image {
                    x: 12px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.icon;
                    colorize: Design.muted-foreground;
                }

                input-field := TextInput {
                    x: root.icon.width > 0 ? 36px : 12px;
                    y: 0px;
                    width: parent.width - self.x - 12px;
                    height: parent.height;
                    text <=> root.text;
                    font-family: Design.font-family;
                    font-size: Design.font-base;
                    color: Design.foreground;
                    vertical-alignment: center;
                    single-line: true;
                    read-only: !root.enabled;
                    input-type: root.secret ? InputType.password
                        : root.numeric ? InputType.number : InputType.text;
                    edited => {
                        root.edited(self.text);
                    }
                    accepted => {
                        root.accepted(self.text);
                    }
                }

                if (root.text == "") : Text {
                    x: input-field.x;
                    y: 0px;
                    width: input-field.width;
                    height: parent.height;
                    text: root.placeholder;
                    color: Design.subtle-foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-base;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            if (root.error != "" || root.hint != "") : Text {
                text: root.error != "" ? root.error : root.hint;
                color: root.error != "" ? Design.destructive : Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-xs;
                wrap: word-wrap;
            }
        }
    }
}

// --- Select -----------------------------------------------------------------

// A dropdown that looks like Input. Click opens a popup under the box, the
// same width as the box (or `popup-min-width`). Items are 32px; the list is
// capped at 320px and scrolls. `current-index` is -1 for no selection.
// `selected(index)` fires when the user picks an item.
export component Select inherits Rectangle {
    in property <[SelectItem]> items;
    in-out property <int> current-index: -1;
    in property <string> placeholder;
    in property <string> label;
    in property <string> error;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <length> popup-min-width: 0px;
    callback selected(int);

    private property <bool> has-value: root.current-index >= 0 && root.current-index < root.items.length;
    // the popup panel is inset by `pad` on every side so its shadow is not clipped
    private property <length> pad: 16px;
    private property <length> pw: max(root.width, root.popup-min-width);
    // The list's natural height: 32px per item, capped at 320px.
    private property <length> natural-h: min(320px, root.items.length * 32px + 8px);
    // Room above and below the box inside the window, with 8px to spare at the edge.
    private property <length> space-below: WindowMetrics.height - field.absolute-position.y - field.height - 8px;
    private property <length> space-above: field.absolute-position.y - 8px;
    // Open below when the list fits there or there is more room below than above.
    private property <bool> open-above: !(root.natural-h <= root.space-below || root.space-below >= root.space-above);
    // The list is capped to the room on the side it opens to, at least 120px.
    private property <length> list-h: min(root.natural-h, max(120px, root.open-above ? root.space-above : root.space-below));

    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: col.preferred-height;

    col := VerticalLayout {
        spacing: 8px;

        if (root.label != "") : Text {
            text: root.label;
            color: Design.foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            font-weight: 500;
            height: 16px;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        VerticalLayout {
            spacing: 6px;

            field := Rectangle {
                height: 36px;
                border-radius: Design.radius-md;
                border-width: 1px;
                border-color: root.error != "" ? Design.destructive
                    : (open-popup.is-open ? Design.ring : Design.input);
                // Solid, so a field over a picture (Home's background) stays
                // readable; on a card it matches the card.
                background: Design.card;
                opacity: root.enabled ? 1 : 0.5;

                value-text := EmojiText {
                    x: 12px;
                    y: 0px;
                    width: parent.width - 12px - 12px - 16px - 8px;
                    height: parent.height;
                    runs: root.has-value ? root.items[root.current-index].text-runs : [];
                    fallback: root.has-value ? root.items[root.current-index].text : root.placeholder;
                    color: root.has-value ? Design.foreground : Design.subtle-foreground;
                    font-size: Design.font-base;
                    wrap: false;
                }

                Image {
                    x: parent.width - 28px;
                    y: (parent.height - 16px) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("assets/icons/chevron-down.svg");
                    colorize: Design.muted-foreground;
                }

                field-ta := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => {
                        if (!open-popup.is-open) {
                            open-popup.show();
                        }
                    }
                }

                open-popup := PopupWindow {
                    x: -root.pad;
                    // 4px from the box, on the side with room: below, or above when
                    // the list does not fit below.
                    y: root.open-above ? -root.list-h - 4px - root.pad : field.height + 4px - root.pad;
                    width: root.pw + 2 * root.pad;
                    height: root.list-h + 2 * root.pad;
                    close-policy: close-on-click-outside;

                    Rectangle {
                        x: root.pad;
                        y: root.pad;
                        width: root.pw;
                        height: root.list-h;
                        background: Design.popover;
                        border-width: 1px;
                        border-color: Design.border;
                        border-radius: Design.radius-md;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: Design.shadow;

                        ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;

                            for item[i] in root.items : Rectangle {
                                height: 32px;
                                border-radius: Design.radius-sm;
                                background: item-ta.has-hover ? Design.accent : transparent;

                                item-label := EmojiText {
                                    x: 8px;
                                    y: 0px;
                                    width: parent.width - 16px - item-detail.preferred-width
                                        - (root.current-index == i ? 24px : 0px);
                                    height: parent.height;
                                    runs: item.text-runs;
                                    fallback: item.text;
                                    color: Design.foreground;
                                    font-size: Design.font-base;
                                    wrap: false;
                                }

                                item-detail := Text {
                                    x: parent.width - self.width - 8px - (root.current-index == i ? 24px : 0px);
                                    y: 0px;
                                    width: self.preferred-width;
                                    height: parent.height;
                                    text: item.detail;
                                    color: item.detail-color;
                                    font-family: Design.font-family;
                                    font-size: Design.font-xs;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }

                                if (root.current-index == i) : Image {
                                    x: parent.width - 24px;
                                    y: (parent.height - 16px) / 2;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("assets/icons/check.svg");
                                    colorize: Design.foreground;
                                }

                                item-ta := TouchArea {
                                    enabled: root.enabled;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.current-index = i;
                                        root.selected(i);
                                        open-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (root.error != "" || root.hint != "") : Text {
                text: root.error != "" ? root.error : root.hint;
                color: root.error != "" ? Design.destructive : Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-xs;
                wrap: word-wrap;
            }
        }
    }
}

// --- Switch -----------------------------------------------------------------

// A 36x20 on/off switch, animated over 150 ms. It is controlled: it shows
// `checked` and never changes it. A click or Space only calls `toggled` with
// the new value, and the owner decides. If the owner does not update
// `checked`, the switch stays where it was.
export component Switch inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    private property <bool> live: root.enabled;

    width: 36px;
    height: 20px;
    border-radius: Design.radius-full;
    background: root.checked ? Design.primary : Design.input;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: 150ms; }

    function toggle() {
        root.toggled(!root.checked);
    }

    Rectangle {
        x: root.checked ? 18px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: Design.radius-full;
        background: #ffffff;
        animate x { duration: 150ms; }
    }

    fs := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (root.live && (event.text == " " || event.text == "\n")) {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => {
            root.toggle();
        }
    }
}

// --- Segmented --------------------------------------------------------------

// A tab-like segmented control: a track with one selected item. Items are
// 30px tall, sized to their text. Left and right arrows move the selection
// while the control has focus. `selected(index)` fires on every change.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    callback selected(int);

    height: 36px;
    border-radius: Design.radius-md;
    background: Design.secondary;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    row := HorizontalLayout {
        padding: 3px;

        for option[i] in root.options : Rectangle {
            height: 30px;
            border-radius: Design.radius-sm;
            preferred-width: item-text.preferred-width + 24px;
            background: root.current-index == i ? Design.background : transparent;

            item-text := Text {
                x: 12px;
                y: 0px;
                width: parent.width - 24px;
                height: parent.height;
                text: option;
                color: root.current-index == i ? Design.foreground : Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            item-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }
        }
    }

    fs := FocusScope {
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow && root.current-index > 0) {
                root.current-index -= 1;
                root.selected(root.current-index);
                return accept;
            }
            if (event.text == Key.RightArrow && root.current-index < root.options.length - 1) {
                root.current-index += 1;
                root.selected(root.current-index);
                return accept;
            }
            return reject;
        }
    }
}

// --- Badge ------------------------------------------------------------------

// A 20px pill label. Variants tint the background at 15% of their color.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <BadgeVariant> variant: BadgeVariant.neutral;

    private property <color> tint: root.variant == BadgeVariant.primary ? Design.primary
        : root.variant == BadgeVariant.success ? Design.success
        : root.variant == BadgeVariant.warning ? Design.warning
        : root.variant == BadgeVariant.destructive ? Design.destructive
        : Design.foreground;

    height: 20px;
    preferred-width: label.preferred-width + 16px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Design.radius-full;
    background: root.variant == BadgeVariant.neutral ? Design.secondary
        : root.variant == BadgeVariant.outline ? transparent
        : root.tint.transparentize(0.85);
    border-width: root.variant == BadgeVariant.outline ? 1px : 0px;
    border-color: Design.border;

    label := Text {
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.variant == BadgeVariant.neutral ? Design.muted-foreground
            : root.variant == BadgeVariant.outline ? Design.foreground
            : root.tint;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
    }
}

// --- Card -------------------------------------------------------------------

// A surface: card background, 1px border, radius 12. The body is the children;
// put a CardHeader first when the card needs a title. `inner-padding` defaults to 20.
export component Card inherits Rectangle {
    in property <length> inner-padding: 20px;
    // A clickable card: the whole surface is one target and lights up on
    // hover. Buttons inside it keep their own clicks.
    in property <bool> clickable: false;
    // Draws the card as the chosen one of a list: an accent border.
    in property <bool> selected: false;
    callback clicked();

    background: root.clickable && touch.has-hover ? Design.card-hover : Design.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Design.primary : Design.border;

    // Behind the body, so the controls in it are hit first.
    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.clicked();
        }
    }
    border-radius: Design.radius-lg;
    preferred-height: body.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    body := VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: root.inner-padding;

        @children
    }
}

// The title block of a Card: a 16px semibold title, an optional 13px muted
// description 4px below it, and 16px of space under the whole header. Children
// are placed at the right edge (for example buttons), centered on the title.
export component CardHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;

    vertical-stretch: 0;
    padding-bottom: 16px;

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 0;
            alignment: start;
            spacing: 4px;

            Text {
                text: root.title;
                color: Design.foreground;
                font-family: Design.font-family;
                font-size: Design.font-lg;
                font-weight: 600;
                height: 22px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }

            if (root.description != "") : Text {
                text: root.description;
                color: Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-sm;
                height: 18px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        VerticalLayout {
            vertical-stretch: 0;
            alignment: center;

            HorizontalLayout {
                spacing: 8px;

                @children
            }
        }
    }
}

// --- Separator --------------------------------------------------------------

// A 1px line in the border color. Horizontal by default; `vertical` makes it
// a vertical line that fills the height it is given.
export component Separator inherits Rectangle {
    in property <bool> vertical: false;

    horizontal-stretch: root.vertical ? 0 : 1;
    vertical-stretch: root.vertical ? 1 : 0;
    min-width: root.vertical ? 1px : 0px;
    preferred-width: root.vertical ? 1px : 0px;
    min-height: root.vertical ? 0px : 1px;
    preferred-height: root.vertical ? 0px : 1px;
    background: Design.border;
}

// --- Progress ---------------------------------------------------------------

// A 6px bar. `value` is 0 to 1. The fill turns warning at 80% and destructive
// at 95%.
export component Progress inherits Rectangle {
    in property <float> value: 0;

    height: 6px;
    horizontal-stretch: 1;
    border-radius: Design.radius-full;
    background: Design.secondary;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * max(0.0, min(1.0, root.value));
        height: parent.height;
        border-radius: Design.radius-full;
        background: root.value >= 0.95 ? Design.destructive
            : root.value >= 0.8 ? Design.warning
            : Design.primary;
    }
}

// --- Alert ------------------------------------------------------------------

// A banner: a 16px icon, an optional bold title, optional text, and an
// optional close button (`closable`, fires `dismissed`). Text longer than four
// lines is cut, and `expandable` (set it for long texts) adds a "Show more" button. `icon` defaults to a glyph for the
// variant.
export component Alert inherits Rectangle {
    in property <AlertVariant> variant: AlertVariant.info;
    in property <string> title;
    in property <string> text;
    in property <bool> closable: false;
    // Set when the text is long enough to need "Show more" (the component cannot measure it).
    in property <bool> expandable: false;
    // Runs of `text` (emoji as pictures); empty = plain text.
    in property <[TextRun]> text-runs;
    // An optional button under the text, for example "Renew"; fires `action`.
    in property <string> action-text;
    callback action();
    in property <image> icon: root.variant == AlertVariant.error ? @image-url("assets/icons/triangle-alert.svg")
        : root.variant == AlertVariant.success ? @image-url("assets/icons/circle-check.svg")
        : root.variant == AlertVariant.warning ? @image-url("assets/icons/triangle-alert.svg")
        : @image-url("assets/icons/info.svg");
    callback dismissed();

    private property <bool> expanded: false;
    private property <color> ink: root.variant == AlertVariant.error ? Design.destructive
        : root.variant == AlertVariant.success ? Design.success
        : root.variant == AlertVariant.warning ? Design.warning
        : Design.muted-foreground;

    horizontal-stretch: 1;
    vertical-stretch: 0;
    preferred-height: lay.preferred-height;
    border-radius: Design.radius-md;
    border-width: 1px;
    border-color: root.variant == AlertVariant.error ? Design.destructive.transparentize(0.6)
        : root.variant == AlertVariant.warning ? Design.warning.transparentize(0.6)
        : root.variant == AlertVariant.success ? Design.success.transparentize(0.6)
        : Design.border;
    background: root.variant == AlertVariant.error ? Design.destructive.transparentize(0.9)
        : root.variant == AlertVariant.warning ? Design.warning.transparentize(0.9)
        : root.variant == AlertVariant.success ? Design.success.transparentize(0.9)
        : transparent;

    lay := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;

        Image {
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: root.ink;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

            if (root.title != "") : Text {
                text: root.title;
                color: Design.foreground;
                font-family: Design.font-family;
                font-size: Design.font-base;
                font-weight: 600;
                wrap: word-wrap;
            }

            body-text := EmojiText {
                visible: root.text != "" || root.text-runs.length > 0;
                runs: root.text-runs;
                fallback: root.text;
                color: Design.foreground;
                font-size: Design.font-sm;
                wrap: true;
                max-height: root.expanded ? 100000px : 72px;
            }

            if (root.expandable) : Button {
                text: root.expanded ? @tr("Show less") : @tr("Show more");
                variant: ButtonVariant.ghost;
                size: ButtonSize.sm;
                clicked => {
                    root.expanded = !root.expanded;
                }
            }

            if (root.action-text != "") : HorizontalLayout {
                alignment: start;

                Button {
                    text: root.action-text;
                    variant: ButtonVariant.outline;
                    size: ButtonSize.sm;
                    clicked => {
                        root.action();
                    }
                }
            }
        }

        if (root.closable) : IconButton {
            icon: @image-url("assets/icons/x.svg");
            size: ButtonSize.sm;
            variant: ButtonVariant.ghost;
            clicked => {
                root.dismissed();
            }
        }
    }
}

// --- ConfirmDialog ----------------------------------------------------------

// A modal dialog: 420px, centered over the element it is placed in, with a
// title, a message and right-aligned buttons. Place it as the last child of an
// element that fills the area it should cover (its own width and height come
// from its parent). Call show() and close(); `confirmed` and `canceled` fire
// on the buttons. The confirm button is destructive by default.
export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-text: @tr("Confirm");
    in property <string> cancel-text: @tr("Cancel");
    in property <ButtonVariant> confirm-variant: ButtonVariant.destructive;
    in property <bool> busy: false;
    callback confirmed();
    callback canceled();

    private property <length> pad: 20px;


    public function show() {
        dlg.show();
    }

    public function close() {
        dlg.close();
    }

    dlg := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        // 420px, or the window less a 16px margin on each side on a phone.
        width: min(420px, WindowMetrics.width - 32px - 2 * root.pad) + 2 * root.pad;
        height: panel.height + 2 * root.pad;
        close-policy: no-auto-close;

        panel := Rectangle {
            x: root.pad;
            y: root.pad;
            width: min(420px, WindowMetrics.width - 32px - 2 * root.pad);
            height: col.preferred-height;
            background: Design.popover;
            border-width: 1px;
            border-color: Design.border;
            border-radius: Design.radius-lg;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Design.shadow;

            col := VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 24px;
                spacing: 12px;

                Text {
                    text: root.title;
                    color: Design.foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-lg + 2px;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: root.message;
                    color: Design.muted-foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-base;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 12px;

                    Button {
                        text: root.cancel-text;
                        variant: ButtonVariant.outline;
                        size: ButtonSize.md;
                        clicked => {
                            dlg.close();
                            root.canceled();
                        }
                    }

                    Button {
                        text: root.confirm-text;
                        variant: root.confirm-variant;
                        size: ButtonSize.md;
                        busy: root.busy;
                        clicked => {
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}

// --- EmptyState -------------------------------------------------------------

// A centered block for an empty list: a 40px icon circle, a semibold title, one
// line of muted text and an optional secondary button. Put it inside a Card.
export component EmptyState inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    in property <string> action-text;
    callback action();

    vertical-stretch: 0;
    preferred-height: col.preferred-height;

    col := VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 24px;
        spacing: 12px;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Design.radius-full;
                background: Design.secondary;

                Image {
                    x: 10px;
                    y: 10px;
                    width: 20px;
                    height: 20px;
                    source: root.icon;
                    colorize: Design.muted-foreground;
                }
            }
        }

        Text {
            text: root.title;
            color: Design.foreground;
            font-family: Design.font-family;
            font-size: Design.font-base + 1px;
            font-weight: 600;
            horizontal-alignment: center;
            height: 22px;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        Text {
            text: root.text;
            color: Design.muted-foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if (root.action-text != "") : HorizontalLayout {
            alignment: center;

            Button {
                text: root.action-text;
                variant: ButtonVariant.secondary;
                size: ButtonSize.md;
                clicked => {
                    root.action();
                }
            }
        }
    }
}

// --- LatencyText ------------------------------------------------------------

// A latency as text: "—" when untested, "timeout" at 0, otherwise "123 ms",
// colored green under 200 ms, amber under 500 ms, red from 500 ms.
export component LatencyText inherits Text {
    in property <int> ms: -1;

    text: LatencyFormat.latency-text(root.ms);
    color: LatencyFormat.latency-color(root.ms);
    font-family: Design.font-family;
    font-size: Design.font-xs;
    font-weight: 500;
    vertical-alignment: center;
    horizontal-alignment: right;
    wrap: no-wrap;
}

// --- PageHeader -------------------------------------------------------------

// The title block at the top of a page: a 20px semibold title and an optional
// 14px muted description 4px below. Children are the page's actions, placed
// at the right and centered on the title block. The 24px below the header is
// the only gap before the page's first block, so a page must not add spacing
// of its own after the header.
//
// The header is a layout with no stretch, so it is exactly as tall as its
// content and never grows to fill the page.
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;

    // On a narrow window (a phone) the actions go under the title, so the
    // description keeps the full width instead of wrapping word by word.
    private property <bool> stacked: WindowMetrics.width < 560px && actions.preferred-width > 0;

    vertical-stretch: 0;
    padding-bottom: 24px;

    GridLayout {
        vertical-stretch: 0;
        spacing-horizontal: 16px;
        spacing-vertical: root.stacked ? 16px : 0px;

        VerticalLayout {
            row: 0;
            col: 0;
            horizontal-stretch: 1;
            vertical-stretch: 0;
            alignment: start;
            spacing: 4px;

            Text {
                text: root.title;
                color: Design.foreground;
                font-family: Design.font-family;
                font-size: Design.font-xl;
                font-weight: 600;
                height: 26px;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }

            if (root.description != "") : Text {
                text: root.description;
                color: Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-base;
                min-height: 20px;
                vertical-alignment: center;
                // Wraps in a narrow window instead of cutting the sentence.
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            row: root.stacked ? 1 : 0;
            col: root.stacked ? 0 : 1;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            alignment: center;

            actions := HorizontalLayout {
                spacing: 8px;
                alignment: start;

                @children
            }
        }
    }
}

// --- PageFrame --------------------------------------------------------------

// The scrolling body of a page: 32px left and right, 28px top, 32px bottom,
// and a content column at most 920px wide, left-aligned. Put the page's
// PageHeader and cards in it as its children. The children stack with no gap:
// PageHeader brings its own 24px, and a page with several blocks wraps them in
// a VerticalLayout with the 16px spacing.
export component PageFrame inherits Rectangle {
    ScrollView {
        width: parent.width;
        height: parent.height;
        // The scrollable area is at least the window and at least the page's
        // own height. Without this the page was laid out to the window height,
        // and cards near the bottom were squeezed into each other.
        content-height: max(self.height, body.preferred-height);
        // The page is as wide as the window, never wider: a row that asks
        // for more room wraps or elides instead of scrolling sideways.
        content-width: self.visible-width;

        body := HorizontalLayout {
            // No vertical stretch: the page is as tall as its content, so it
            // starts at the top of the scroll area.
            vertical-stretch: 0;
            // Phone-width windows keep 16px margins so the content gets the room.
            padding-left: WindowMetrics.width < 600px ? 16px : 32px;
            padding-right: WindowMetrics.width < 600px ? 16px : 32px;
            padding-top: WindowMetrics.width < 600px ? 20px : 28px;
            padding-bottom: 32px;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                alignment: start;
                max-width: 920px;
                spacing: 0px;

                @children
            }
        }
    }
}
