// The design tokens.
//
// Every colour, radius, space and font size the app uses is declared once
// here. Screens and primitives refer to these names, never to a literal
// value, so a change to the look is a change in this file.
//
// The values are the ones in docs/design/ui-spec.md section 2: a zinc dark
// theme with the Starpod brand red. The theme is dark only.

export global Design {
    // --- surfaces -----------------------------------------------------------
    // window ground
    in property <color> background: #111113;
    // sidebar ground
    in property <color> sidebar: #0c0c0e;
    // cards and list rows
    in property <color> card: #18181b;
    // hovered rows and tiles
    in property <color> card-hover: #1f1f23;
    // select popups and dialogs
    in property <color> popover: #1c1c1f;
    // secondary button, segmented track
    in property <color> secondary: #27272a;
    // secondary button hover
    in property <color> secondary-hover: #323236;
    // subtle fills
    in property <color> muted: #1f1f23;
    // hover in menus
    in property <color> accent: #27272a;

    // --- brand and state ----------------------------------------------------
    // primary action, selection, connected. The accent colour: Rust sets it
    // from the user's choice, and the shades below follow it.
    in property <color> primary: #de6161;
    out property <color> primary-hover: self.primary.mix(#ffffff, 0.85);
    out property <color> primary-pressed: self.primary.mix(#000000, 0.9);
    // selected tile fill, connected ring (12% alpha)
    out property <color> primary-soft: self.primary.with-alpha(0.12);
    in property <color> primary-foreground: #ffffff;
    // latency under 200 ms, connected dot
    in property <color> success: #4ade80;
    // latency 200 to 499 ms
    in property <color> warning: #fbbf24;
    // errors, delete, latency 500 ms and up, timeout
    in property <color> destructive: #ef4444;
    // focus ring
    out property <color> ring: self.primary;

    // --- text ---------------------------------------------------------------
    in property <color> foreground: #fafafa;
    in property <color> muted-foreground: #a1a1aa;
    in property <color> subtle-foreground: #71717a;
    // kept for the info banner and other neutral status text
    in property <color> info: #a1a1aa;

    // --- lines --------------------------------------------------------------
    // card borders, dividers
    in property <color> border: #27272a;
    // input and select borders
    in property <color> input: #3f3f46;

    // --- radii --------------------------------------------------------------
    in property <length> radius-sm: 6px;
    in property <length> radius-md: 8px;
    in property <length> radius-lg: 12px;
    in property <length> radius-full: 9999px;

    // --- spacing (4px grid) -------------------------------------------------
    in property <length> space-xs: 4px;
    in property <length> space-sm: 8px;
    in property <length> space-md: 12px;
    in property <length> space-lg: 16px;
    in property <length> space-5: 20px;
    in property <length> space-xl: 24px;
    in property <length> space-2xl: 32px;
    in property <length> space-12: 48px;

    // --- type ---------------------------------------------------------------
    in property <string> font-family: "Inter Variable";
    // Monospace, for logs and raw rules only. Consolas ships with Windows.
    in property <string> font-mono: "Consolas";
    in property <length> font-xs: 12px;
    in property <length> font-sm: 13px;
    in property <length> font-base: 14px;
    in property <length> font-lg: 16px;
    in property <length> font-xl: 20px;
    in property <length> font-2xl: 28px;

    // --- effects ------------------------------------------------------------
    // drop shadow of floating surfaces (select popups, dialogs)
    in property <color> shadow: #00000080;
}
