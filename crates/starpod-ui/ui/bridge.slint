// The Rust <-> UI contract.
//
// This file holds data and callbacks only. Rust owns the state: it pushes
// every property here and handles every callback. Nothing in this file
// decides anything (ARCHITECTURE §6.3).
//
// Enumerated values are plain strings, so the Rust side can map them from
// its domain enums without a second set of Slint enums.

export struct SubscriptionItem {
    id: string,
    label: string,
    // "app-managed" | "engine-managed"
    mode: string,
    // "ok" | "error" | "syncing" | "never"
    status: string,
    last-updated: string,
    error: string,
    node-count: int,
    has-quota: bool,
    quota-used-fraction: float,
    quota-text: string,
    expires: string,
}

export struct NodeItem {
    id: string,
    name: string,
    protocol: string,
    group: string,
    // -1 = untested
    latency-ms: int,
    selected: bool,
}

export struct RuleItem {
    index: int,
    kind: string,
    payload: string,
    target: string,
    line: string,
    // A disabled rule is kept in the list but takes no part in routing.
    enabled: bool,
    from-subscription: bool,
    error: string,
}

export struct LogItem {
    time: string,
    level: string,
    source: string,
    message: string,
}

// The settings form. A number that is not set is -1 and shows as an empty
// field. An empty bind address or device name means "not set" too.
export struct SettingsModel {
    // -1 = not set (the listener uses its default; HTTP is off); 1-65535 = port
    mixed-port: int,
    socks-port: int,
    http-port: int,
    allow-lan: bool,
    // "" = not set (loopback)
    bind-address: string,
    log-level: string,
    mode: string,
    tun-enabled: bool,
    // "" = not set (the engine's default device)
    tun-device: string,
    // -1 = not set (the engine default); 1280-9000 = MTU
    tun-mtu: int,
    // -1 = not set (the app default, 60); 0 = manual only; otherwise minutes
    auto-refresh-minutes: int,
}

export global Bridge {
    // --- navigation ---------------------------------------------------------
    // 0 Dashboard, 1 Servers, 2 Rules, 3 Settings, 4 Logs
    in-out property <int> active-page: 0;

    // --- engine -------------------------------------------------------------
    // "stopped" | "starting" | "running" | "stopping" | "failed"
    in-out property <string> engine-phase: "stopped";
    in-out property <string> engine-error: "";
    in-out property <bool> engine-installed: false;
    // Why Connect and Restart are blocked, or "" when they are allowed. Rust
    // decides it: the engine must be installed and at least one subscription
    // must supply servers.
    in-out property <string> connect-blocked-reason: "";
    in-out property <string> engine-version: "";
    in-out property <bool> busy: false;
    in-out property <string> busy-message: "";
    // "info" | "success" | "error"
    in-out property <string> banner-message: "";
    in-out property <string> banner-kind: "info";
    // The routing mode as the engine reports it, for example "rule", "global" or "direct"
    in-out property <string> mode: "";
    in-out property <string> current-node: "";
    in-out property <string> uptime: "";
    in-out property <string> listen-address: "";
    // false until the first state push; screens show LoadingState until then
    in-out property <bool> loaded: false;

    // --- servers ------------------------------------------------------------
    in-out property <[SubscriptionItem]> subscriptions: [];
    in-out property <[NodeItem]> nodes: [];
    in-out property <string> node-filter: "";

    // --- rules --------------------------------------------------------------
    in-out property <[RuleItem]> user-rules: [];
    in-out property <[RuleItem]> subscription-rules: [];
    in-out property <[string]> rule-kinds: [];
    in-out property <[string]> rule-targets: [];
    in-out property <string> rules-raw-text: "";
    in-out property <string> rules-error: "";

    // --- logs ---------------------------------------------------------------
    in-out property <[LogItem]> logs: [];
    in-out property <string> log-level-filter: "all";

    // --- settings -----------------------------------------------------------
    in-out property <SettingsModel> settings;
    in-out property <string> settings-error: "";
    in-out property <string> secret-backend: "";
    in-out property <bool> secrets-encrypted: false;
    // Why the platform keyring was not used. Empty when it was used, or when
    // the reason is not known.
    in-out property <string> secret-fallback-reason: "";
    in-out property <string> data-dir: "";

    // --- shell --------------------------------------------------------------
    in-out property <bool> tray-available: false;
    // Non-blocking findings from the last successful build, for the Dashboard.
    in-out property <[string]> warnings: [];

    // --- callbacks: engine --------------------------------------------------
    callback connect();
    callback disconnect();
    callback restart();
    callback set-mode(string);
    callback install-engine();

    // --- callbacks: subscriptions and nodes ---------------------------------
    // label, url, auth header, mode
    callback add-subscription(string, string, string, string);
    callback remove-subscription(string);
    callback refresh-subscription(string);
    callback refresh-all();
    // subscription id, mode
    callback set-subscription-mode(string, string);
    callback select-node(string);
    callback test-latency();

    // --- callbacks: rules ---------------------------------------------------
    // kind, payload, target
    callback add-rule(string, string, string);
    // index, kind, payload, target
    callback update-rule(int, string, string, string);
    callback delete-rule(int);
    // index, delta
    callback move-rule(int, int);
    // index, enabled
    callback set-rule-enabled(int, bool);
    callback apply-raw-rules(string);

    // --- callbacks: settings and logs ---------------------------------------
    callback save-settings(SettingsModel);
    callback clear-cache();
    callback copy-logs();
    callback clear-logs();

    // --- callbacks: shell ---------------------------------------------------
    callback dismiss-banner();
    callback show-window();
    callback hide-window();
    callback quit();
}
