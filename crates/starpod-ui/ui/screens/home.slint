// Home: the active profile card (logo, quota, expiry and its warning), the
// other profiles' announcements, the connect button with its status line, and
// the server picker of the primary group. The cards sit at the top, the picker
// at the bottom, and the button in the middle. The routing mode, the system
// proxy, TUN and the session traffic are on the Proxies page.

import { Design } from "../design.slint";
import { Bridge, AnnouncementItem, ProfileCardItem, TextRun } from "../bridge.slint";
import {
    Button, ButtonVariant, ButtonSize, Card, Select, EmojiText, Alert, AlertVariant,
    IconButton, Progress
} from "../primitives.slint";
import { ScrollView } from "std-widgets.slint";

// An announcement of a profile: the megaphone and the title, the text (six
// lines, then "Show more") and the link when the provider sent one.
component AnnouncementCard inherits Rectangle {
    in property <AnnouncementItem> item;

    private property <bool> expanded: false;
    // About 50 characters fit a line at this width, six lines hold about 300.
    private property <bool> long: root.item.text.character-count > 300;

    vertical-stretch: 0;
    horizontal-stretch: 1;
    preferred-height: lay.preferred-height;
    background: Design.card;
    border-width: 1px;
    border-color: Design.border;
    border-radius: Design.radius-md;

    lay := VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            vertical-stretch: 0;
            height: 18px;
            spacing: 8px;

            Image {
                width: 16px;
                height: 16px;
                source: @image-url("../assets/icons/megaphone.svg");
                colorize: Design.primary;
            }

            EmojiText {
                horizontal-stretch: 1;
                min-width: 0px;
                runs: root.item.title-runs;
                fallback: root.item.title;
                color: Design.foreground;
                font-size: Design.font-sm;
                font-weight: 600;
                wrap: false;
            }
        }

        EmojiText {
            runs: root.item.text-runs;
            fallback: root.item.text;
            color: Design.foreground;
            font-size: Design.font-base;
            wrap: true;
            // Two lines of 20px unless expanded.
            max-height: root.expanded ? 100000px : 40px;
        }

        if (root.item.announce-url != "" || root.long) : HorizontalLayout {
            vertical-stretch: 0;
            height: 28px;
            alignment: start;
            spacing: 4px;

            if (root.item.announce-url != "") : Button {
                text: @tr("Learn more");
                icon: @image-url("../assets/icons/external-link.svg");
                variant: ButtonVariant.ghost;
                size: ButtonSize.sm;
                clicked => {
                    Bridge.open-url(root.item.announce-url);
                }
            }

            if (root.long) : Button {
                text: root.expanded ? @tr("Show less") : @tr("Show more");
                variant: ButtonVariant.ghost;
                size: ButtonSize.sm;
                clicked => {
                    root.expanded = !root.expanded;
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    // "stopped" and "failed" look alike; "starting" and "stopping" pulse.
    private property <bool> running: Bridge.engine-phase == "running";
    private property <bool> transitioning: Bridge.engine-phase == "starting" || Bridge.engine-phase == "stopping";
    private property <bool> blocked: !root.running && Bridge.connect-blocked-reason != "";
    private property <bool> clickable: !root.blocked && !root.transitioning;
    private property <bool> hovered: ta.has-hover && root.clickable;
    private property <bool> pulse-high: true;

    private property <string> status-title: root.running ? @tr("Connected")
        : Bridge.engine-phase == "starting" ? @tr("Connecting…")
        : Bridge.engine-phase == "stopping" ? @tr("Disconnecting…")
        : Bridge.engine-phase == "failed" ? @tr("Couldn't connect")
        : @tr("Not connected");
    private property <string> status-line: root.running ? @tr("Up {} · {}", Bridge.uptime, Bridge.listen-address)
        : root.blocked ? Bridge.connect-blocked-reason
        : Bridge.engine-phase == "failed" ? Bridge.engine-error
        : "";
    // Empty while running, so the "Up ..." line uses its plain text.
    private property <[TextRun]> status-runs: root.running ? []
        : (Bridge.engine-phase == "failed" && !root.blocked) ? Bridge.engine-error-runs
        : Bridge.connect-blocked-reason-runs;

    // The profile card of the active subscription.
    private property <bool> has-card: Bridge.profile-card.present;
    private property <int> days: Bridge.profile-card.days-remaining;
    private property <string> expiry-title: root.days < 0 ? @tr("Your subscription has ended")
        : root.days == 0 ? @tr("Your subscription expires today")
        : root.days == 1 ? @tr("Your subscription expires in 1 day")
        : @tr("Your subscription expires in {n} day" | "Your subscription expires in {n} days" % root.days);
    private property <string> renew-url: Bridge.profile-card.web-url != "" ? Bridge.profile-card.web-url : Bridge.profile-card.support-url;

    // The server picker works on the primary group. group-index is that group's
    // place in the groups list; sel-index is the server in use within it.
    private property <int> group-index: 0;
    private property <int> sel-index: -1;
    // group-index, kept inside the groups list.
    private property <int> gi: max(0, min(root.group-index, Bridge.groups.length - 1));

    background: transparent;

    // The pulse of the icon while the engine is starting or stopping.
    Timer {
        interval: 900ms;
        running: root.transitioning;
        triggered => {
            root.pulse-high = !root.pulse-high;
        }
    }

    // Slint has no search over a model, so these invisible repeaters find the
    // indexes: each element compares itself with the name it looks for when it
    // is created. A rebuilt model runs them again.
    for g[i] in Bridge.groups : Rectangle {
        visible: false;
        init => {
            if (g.name == Bridge.primary-group) {
                root.group-index = i;
            }
        }
    }

    for m[i] in Bridge.groups[root.gi].members : Rectangle {
        visible: false;
        init => {
            if (m.name == Bridge.groups[root.gi].selected) {
                root.sel-index = i;
            }
        }
    }

    ScrollView {
        width: parent.width;
        height: parent.height;
        // At least the window's height, and at least the column's own height,
        // so a short window scrolls to the picker instead of squeezing it.
        content-height: max(self.height, stack.preferred-height);

        HorizontalLayout {
            vertical-stretch: 1;
            alignment: center;

            // The 440px column, centred in the page, in three parts: the
            // profile card and the news at the top, the server picker at the
            // bottom, and the connect button with its status centred in the
            // space between. A short window scrolls instead of squeezing it.
            stack := VerticalLayout {
                horizontal-stretch: 0;
                vertical-stretch: 1;
                width: 440px;
                padding-top: 12px;
                padding-bottom: 16px;
                spacing: 0px;

                // The active profile: header, quota and expiry.
                if (root.has-card) : Card {
                    inner-padding: 16px;

                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        HorizontalLayout {
                            vertical-stretch: 0;
                            height: 32px;
                            spacing: 8px;

                            if (Bridge.profile-card.has-logo) : Image {
                                width: 32px;
                                height: 32px;
                                source: Bridge.profile-card.logo;
                                image-fit: contain;
                            }

                            if (!Bridge.profile-card.has-logo) : Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Design.radius-full;
                                background: Design.secondary;

                                Image {
                                    x: 8px;
                                    y: 8px;
                                    width: 16px;
                                    height: 16px;
                                    source: @image-url("../assets/icons/layers.svg");
                                    colorize: Design.muted-foreground;
                                }
                            }

                            EmojiText {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                runs: Bridge.profile-card.title-runs;
                                fallback: Bridge.profile-card.title;
                                color: Design.foreground;
                                font-size: Design.font-base;
                                font-weight: 600;
                                wrap: false;
                            }

                            if (Bridge.profile-card.support-url != "") : IconButton {
                                icon: @image-url("../assets/icons/life-buoy.svg");
                                tooltip: @tr("Support");
                                size: ButtonSize.sm;
                                clicked => {
                                    Bridge.open-url(Bridge.profile-card.support-url);
                                }
                            }

                            if (Bridge.profile-card.web-url != "") : IconButton {
                                icon: @image-url("../assets/icons/globe.svg");
                                tooltip: Bridge.profile-card.web-page-name != "" ? Bridge.profile-card.web-page-name : @tr("Website");
                                size: ButtonSize.sm;
                                clicked => {
                                    Bridge.open-url(Bridge.profile-card.web-url);
                                }
                            }

                            IconButton {
                                icon: @image-url("../assets/icons/refresh-cw.svg");
                                tooltip: @tr("Refresh profile");
                                size: ButtonSize.sm;
                                enabled: !Bridge.busy;
                                clicked => {
                                    Bridge.refresh-subscription(Bridge.profile-card.subscription-id);
                                }
                            }
                        }

                        if (Bridge.profile-card.has-quota) : VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 6px;

                            Progress {
                                value: Bridge.profile-card.quota-used-fraction;
                            }

                            HorizontalLayout {
                                height: 18px;
                                spacing: 8px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: Bridge.profile-card.traffic-text;
                                    color: Design.muted-foreground;
                                    font-family: Design.font-family;
                                    font-size: Design.font-xs;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                Text {
                                    text: Bridge.profile-card.remaining-text;
                                    color: Design.foreground;
                                    font-family: Design.font-family;
                                    font-size: Design.font-xs;
                                    font-weight: 500;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }
                            }
                        }

                        // The expiry: a warning row with Renew when the plan ends soon,
                        // otherwise the plain date.
                        if (Bridge.profile-card.expiring-soon) : Rectangle {
                            vertical-stretch: 0;
                            height: 36px;
                            border-radius: Design.radius-md;
                            border-width: 1px;
                            border-color: Design.warning.transparentize(0.6);
                            background: Design.warning.transparentize(0.9);

                            HorizontalLayout {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                spacing: 8px;

                                VerticalLayout {
                                    vertical-stretch: 0;
                                    alignment: center;

                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        source: @image-url("../assets/icons/triangle-alert.svg");
                                        colorize: Design.warning;
                                    }
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    text: root.expiry-title;
                                    color: Design.foreground;
                                    font-family: Design.font-family;
                                    font-size: Design.font-xs;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                    overflow: elide;
                                }

                                if (root.renew-url != "") : VerticalLayout {
                                    vertical-stretch: 0;
                                    alignment: center;

                                    Button {
                                        text: @tr("Renew");
                                        variant: ButtonVariant.outline;
                                        size: ButtonSize.sm;
                                        clicked => {
                                            Bridge.open-url(root.renew-url);
                                        }
                                    }
                                }
                            }
                        }

                        if (!Bridge.profile-card.expiring-soon && Bridge.profile-card.expires-text != "") : Text {
                            vertical-stretch: 0;
                            height: 18px;
                            text: Bridge.profile-card.expires-text;
                            color: Design.muted-foreground;
                            font-family: Design.font-family;
                            font-size: Design.font-xs;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }

                if (root.has-card && Bridge.profile-card.device-limit) : VerticalLayout {
                    vertical-stretch: 0;
                    padding-top: 12px;

                    Alert {
                        variant: AlertVariant.error;
                        title: @tr("Device limit reached");
                        text: @tr("This device is at the device limit set by your provider. Contact support to free a slot.");
                        action-text: Bridge.profile-card.support-url != "" ? @tr("Contact support") : "";
                        action => {
                            Bridge.open-url(Bridge.profile-card.support-url);
                        }
                    }
                }

                // The announcements of the profiles, the active one included.
                if (Bridge.announcements.length > 0) : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 12px;
                    padding-top: 12px;

                    for announcement in Bridge.announcements : AnnouncementCard {
                        item: announcement;
                    }
                }

                // Takes half the free height, so the button sits in the middle.
                // The ring hangs 14px above the button; 18px keeps it clear of
                // the card.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: (root.has-card || Bridge.announcements.length > 0) ? 18px : 0px;
                }

                // The connect button, 120px, with a 148px ring behind it when connected.
                hero := Rectangle {
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    height: 120px;

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: -14px;
                        width: 148px;
                        height: 148px;
                        border-radius: Design.radius-full;
                        background: root.running ? Design.primary-soft : transparent;
                        animate background { duration: 150ms; }
                    }

                    button := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 0px;
                        width: 120px;
                        height: 120px;
                        border-radius: Design.radius-full;
                        background: root.running ? Design.primary : Design.card;
                        border-width: root.running ? 0px : 2px;
                        border-color: (root.hovered || root.transitioning) ? Design.primary : Design.input;
                        opacity: root.blocked ? 0.5 : 1;
                        animate background { duration: 150ms; }
                        animate border-color { duration: 150ms; }

                        // Keyboard focus ring, 2px, offset 2px.
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 48px;
                            height: 48px;
                            source: @image-url("../assets/icons/power.svg");
                            colorize: root.running ? Design.primary-foreground
                                : root.transitioning ? Design.primary
                                : root.hovered ? Design.foreground
                                : Design.muted-foreground;
                            opacity: root.transitioning ? (root.pulse-high ? 1 : 0.4) : 1;
                            animate opacity { duration: 900ms; }
                            animate colorize { duration: 150ms; }
                        }

                        fs := FocusScope {
                            width: parent.width;
                            height: parent.height;
                            key-pressed(event) => {
                                if (root.clickable && (event.text == " " || event.text == "\n")) {
                                    root.toggle();
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        ta := TouchArea {
                            enabled: root.clickable;
                            mouse-cursor: root.clickable ? pointer : default;
                            clicked => {
                                root.toggle();
                            }
                        }
                    }
                }

                // 20px from the button's bottom (the ring reaches 14px below it)
                // to the title.
                Rectangle {
                    vertical-stretch: 0;
                    height: 20px;
                }

                Text {
                    vertical-stretch: 0;
                    text: root.status-title;
                    color: Design.foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-xl;
                    font-weight: 600;
                    horizontal-alignment: center;
                    height: 26px;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }

                if (root.status-line != "") : VerticalLayout {
                    vertical-stretch: 0;
                    padding-top: 2px;

                    EmojiText {
                        runs: root.status-runs;
                        fallback: root.status-line;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        color: Bridge.engine-phase == "failed" && !root.blocked && !root.running
                            ? Design.destructive : Design.muted-foreground;
                        font-size: Design.font-sm;
                        wrap: true;
                        // Three lines at most for an error.
                        max-height: 54px;
                    }
                }

                // The blocked actions, when the engine or a profile is missing.
                if (root.blocked) : VerticalLayout {
                    vertical-stretch: 0;
                    padding-top: 12px;

                    HorizontalLayout {
                        alignment: center;

                        if (!Bridge.engine-installed) : Button {
                            text: @tr("Install engine");
                            variant: ButtonVariant.primary;
                            size: ButtonSize.md;
                            busy: Bridge.busy;
                            clicked => {
                                Bridge.install-engine();
                            }
                        }

                        if (Bridge.engine-installed) : Button {
                            text: @tr("Add a profile");
                            variant: ButtonVariant.primary;
                            size: ButtonSize.md;
                            clicked => {
                                Bridge.active-page = 1;
                            }
                        }
                    }
                }

                // The other half of the free height.
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 16px;
                }

                // The server picker: the primary group's choice, at the foot of
                // the page. Its own page lists every group and server.
                if (Bridge.primary-group != "" && Bridge.groups.length > 0 && Bridge.groups[root.gi].members.length > 0) : HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: center;

                    VerticalLayout {
                        width: 320px;
                        vertical-stretch: 0;
                        spacing: 4px;

                        Select {
                            label: @tr("Server");
                            items: Bridge.groups[root.gi].member-choices;
                            current-index: root.sel-index;
                            enabled: Bridge.groups[root.gi].kind == "select";
                            hint: Bridge.groups[root.gi].kind == "select" ? "" : @tr("Chosen automatically");
                            selected(i) => {
                                root.sel-index = i;
                                Bridge.select-member(Bridge.groups[root.gi].name, Bridge.groups[root.gi].members[i].name);
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            height: 28px;

                            Button {
                                text: @tr("All servers");
                                variant: ButtonVariant.ghost;
                                size: ButtonSize.sm;
                                clicked => {
                                    Bridge.active-page = 2;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    function toggle() {
        if (root.running) {
            Bridge.disconnect();
        } else if (root.clickable) {
            Bridge.connect();
        }
    }
}
