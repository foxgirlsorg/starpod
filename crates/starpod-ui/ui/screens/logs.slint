// The Logs page (docs/design/ui-spec.md section 5.5).
//
// Copy and Clear, a level filter, and a virtualized list of log lines. The
// filter itself is applied by Rust: this file writes `Bridge.log-level-filter`
// and displays whatever `Bridge.logs` holds. The filter values are the level
// names the engine and app use: all, info, warning, error.

import { ScrollView } from "std-widgets.slint";
import { Design } from "../design.slint";
import { Bridge, LogItem } from "../bridge.slint";
import { EmojiText } from "../emoji-text.slint";
import { ButtonSize, ButtonVariant, IconButton, Segmented, Card, EmptyState, PageHeader, WindowMetrics } from "../primitives.slint";

// One log line: time, level, source, message. Each line is laid out at its
// natural width, so the message is never cut short: the list scrolls sideways
// instead. The row is a layout root, so its minimum width (the sum of its
// columns) reaches the list and sets the scrollable width.
component LogRow inherits HorizontalLayout {
    in property <LogItem> entry;

    pure function level-text(level: string) -> string {
        if (level == "error") {
            return @tr("ERROR");
        }
        if (level == "warning") {
            return @tr("WARN");
        }
        if (level == "debug") {
            return @tr("DEBUG");
        }
        return @tr("INFO");
    }

    pure function level-color(level: string) -> color {
        if (level == "error") {
            return Design.destructive;
        }
        if (level == "warning") {
            return Design.warning;
        }
        if (level == "debug") {
            return Design.subtle-foreground;
        }
        return Design.muted-foreground;
    }

    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 12px;
    alignment: start;

    // No width: the time keeps its natural width, so the whole timestamp shows.
    Text {
        text: root.entry.time;
        color: Design.subtle-foreground;
        font-family: Design.font-mono;
        font-size: Design.font-xs;
        vertical-alignment: top;
        wrap: no-wrap;
    }

    Text {
        // Wide enough for the Russian "ОТЛАДКА" as well as "DEBUG".
        width: 72px;
        text: root.level-text(root.entry.level);
        color: root.level-color(root.entry.level);
        font-family: Design.font-family;
        font-size: Design.font-xs;
        font-weight: 600;
        vertical-alignment: top;
        wrap: no-wrap;
    }

    EmojiText {
        width: 90px;
        runs: root.entry.source-runs;
        fallback: root.entry.source;
        color: Design.muted-foreground;
        font-size: Design.font-xs;
        wrap: false;
    }

    EmojiText {
        // Never shorter than the message itself: a line is read whole, and the
        // list scrolls sideways when the window is narrower.
        horizontal-stretch: 1;
        min-width: self.preferred-width;
        runs: root.entry.message-runs;
        fallback: root.entry.message;
        color: Design.foreground;
        font-family: Design.font-mono;
        font-size: Design.font-base;
        wrap: false;
    }
}

export component LogsPage inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    background: transparent;

    // The filter's segments, in order. The index maps to Bridge.log-level-filter.
    pure function filter-index(filter: string) -> int {
        if (filter == "info") {
            return 1;
        }
        if (filter == "warning") {
            return 2;
        }
        if (filter == "error") {
            return 3;
        }
        return 0;
    }

    pure function filter-value(index: int) -> string {
        if (index == 1) {
            return "info";
        }
        if (index == 2) {
            return "warning";
        }
        if (index == 3) {
            return "error";
        }
        return "all";
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        // The same margins as PageFrame, which the other pages use.
        padding-left: WindowMetrics.width < 600px ? 16px : 32px;
        padding-right: WindowMetrics.width < 600px ? 16px : 32px;
        padding-top: WindowMetrics.width < 600px ? 20px : 28px;
        padding-bottom: 32px;

        HorizontalLayout {
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 1;
                max-width: 920px;
                vertical-stretch: 1;
                spacing: 0px;

                PageHeader {
                    title: @tr("Logs");
                    description: @tr("What Starpod and the engine are doing.");

                    IconButton {
                        variant: ButtonVariant.outline;
                        size: ButtonSize.md;
                        icon: @image-url("../assets/icons/copy.svg");
                        tooltip: @tr("Copy all");
                        enabled: Bridge.logs.length > 0;
                        clicked => { Bridge.copy-logs(); }
                    }

                    IconButton {
                        variant: ButtonVariant.outline;
                        size: ButtonSize.md;
                        icon: @image-url("../assets/icons/trash-2.svg");
                        tooltip: @tr("Clear");
                        enabled: Bridge.logs.length > 0;
                        clicked => { Bridge.clear-logs(); }
                    }
                }

                // The header's 24px is the gap above this block. The rest of
                // the page is spaced 16px apart.
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 16px;

                    HorizontalLayout {
                        alignment: start;
                        height: 36px;

                        Segmented {
                            options: [@tr("All"), @tr("Info"), @tr("Warnings"), @tr("Errors")];
                            current-index: root.filter-index(Bridge.log-level-filter);
                            selected(i) => { Bridge.log-level-filter = root.filter-value(i); }
                        }
                    }

                    // A VerticalLayout, not a HorizontalLayout: a wrapped EmojiText
                    // only gets its height-for-width in a vertical parent.
                    if (Bridge.engine-error != "") : VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: @tr("Engine error:");
                            color: Design.destructive;
                            font-family: Design.font-family;
                            font-size: Design.font-sm;
                            wrap: no-wrap;
                        }

                        EmojiText {
                            runs: Bridge.engine-error-runs;
                            fallback: Bridge.engine-error;
                            color: Design.destructive;
                            font-size: Design.font-sm;
                            wrap: true;
                        }
                    }

                    if (Bridge.logs.length == 0) : Card {
                        EmptyState {
                            icon: @image-url("../assets/icons/scroll-text.svg");
                            title: @tr("No logs yet");
                            text: Bridge.log-level-filter == "all"
                                ? @tr("Engine startup and shutdown, validation failures and subscription errors appear here.")
                                : @tr("No lines at this level. Choose All to see every line.");
                        }
                    }

                    if (Bridge.logs.length > 0) : Card {
                        vertical-stretch: 1;
                        inner-padding: 0px;

                        // Scrolls both ways. The content is as wide as the widest
                        // line (each row's minimum width), so a long message scrolls
                        // sideways. A plain for, not a ListView: a ListView only
                        // scrolls vertically.
                        ScrollView {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: start;

                                for log in Bridge.logs : LogRow {
                                    entry: log;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
