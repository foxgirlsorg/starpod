// The Settings page (ui-spec.md section 5.6).
//
// The page opens on a list of the sections. Picking one shows that section,
// a set of cards, at full width, with a back button to the list. The page edits
// two private copies: the draft of Bridge.settings, and the draft of
// Bridge.engine-settings. One bar saves whichever copy changed. Discard rereads
// both. Hotkeys have their own draft and Save, in their section. Privacy and
// the update check save at once, through their own callbacks.
//
// The checks here keep bad input out of the drafts and block Save. Rust still
// validates the final values and reports a refusal through settings-error.

import { Design } from "../design.slint";
import { Bridge, EngineSettingsModel, HotkeyModel, SettingsModel } from "../bridge.slint";
import { Button, ButtonSize, ButtonVariant, Card, CardHeader, ConfirmDialog, EmptyState, IconButton, PageHeader, Separator, SelectItem } from "../primitives.slint";
import { ScrollView } from "std-widgets.slint";
import { DraftChoice, DraftList, DraftNumber, DraftSegmented, DraftSwitch, DraftTri, DraftText, DraftSelect, ListRow, SectionLink, SettingRow } from "settings/controls.slint";
import { EmojiText } from "../emoji-text.slint";

export component SettingsPage inherits Rectangle {
    // --- navigation -----------------------------------------------------------

    // -1 is the section list; 0.. is that section. Kept in Bridge so the
    // section survives a page switch and the screenshot tool can open one.
    private property <int> section: Bridge.settings-section;
    function open-section(i: int) {
        Bridge.settings-section = i;
        scroll.content-y = 0;
    }
    private property <[image]> section-icons: [
        @image-url("../assets/icons/settings.svg"),
        @image-url("../assets/icons/wifi.svg"),
        @image-url("../assets/icons/network.svg"),
        @image-url("../assets/icons/globe.svg"),
        @image-url("../assets/icons/scan-search.svg"),
        @image-url("../assets/icons/map.svg"),
        @image-url("../assets/icons/cpu.svg"),
        @image-url("../assets/icons/server.svg"),
        @image-url("../assets/icons/shield.svg"),
        @image-url("../assets/icons/keyboard.svg"),
        @image-url("../assets/icons/hard-drive.svg"),
    ];
    private property <[string]> section-names: [
        @tr("General"), @tr("Network"), @tr("TUN"), @tr("DNS"), @tr("Sniffer"), @tr("Geo data"),
        @tr("Engine"), @tr("Proxies"), @tr("Privacy"), @tr("Hotkeys"), @tr("Storage"),
    ];
    private property <[string]> section-texts: [
        @tr("Startup, routing, subscriptions and updates"),
        @tr("Ports, LAN access, IPv6 and the system proxy"),
        @tr("The virtual adapter that routes all system traffic"),
        @tr("How the engine resolves names"),
        @tr("Reads domain names from the traffic"),
        @tr("The GeoIP and GeoSite databases"),
        @tr("The proxy engine: version, logs, tests and connections"),
        @tr("How proxy groups behave"),
        @tr("What is sent to subscription providers"),
        @tr("Global keyboard shortcuts"),
        @tr("Where secrets and data are kept"),
    ];

    // --- drafts and checks ----------------------------------------------------

    private property <SettingsModel> draft: Bridge.settings;
    private property <EngineSettingsModel> edraft: Bridge.engine-settings;
    private property <HotkeyModel> hk: Bridge.hotkeys;
    // Bumped whenever the drafts are read again from Bridge. Every control
    // then shows its draft value again.
    private property <int> rev: 0;

    // Mirrors of Bridge, for change handlers: a push from Rust resets the draft.
    private property <SettingsModel> pushed: Bridge.settings;
    private property <EngineSettingsModel> engine-pushed: Bridge.engine-settings;
    private property <HotkeyModel> hotkeys-pushed: Bridge.hotkeys;

    private property <bool> core-dirty: root.draft != Bridge.settings;
    private property <bool> engine-dirty: root.edraft != Bridge.engine-settings;
    private property <bool> hk-dirty: root.hk != Bridge.hotkeys;
    private property <bool> dirty: root.core-dirty || root.engine-dirty;

    // false while a number field holds text the range does not accept
    private property <bool> ok-mixed: true;
    private property <bool> ok-socks: true;
    private property <bool> ok-http: true;
    private property <bool> ok-mtu: true;
    private property <bool> ok-keep-alive: true;
    private property <bool> ok-retention: true;
    private property <bool> ok-interval: true;
    private property <bool> ok-timeout: true;

    // An unset port (-1) is not a listener, so it cannot clash.
    private property <bool> mixed-clash: root.draft.mixed-port > 0
        && (root.draft.mixed-port == root.draft.socks-port || root.draft.mixed-port == root.draft.http-port);
    private property <bool> socks-clash: root.draft.socks-port > 0
        && (root.draft.socks-port == root.draft.mixed-port || root.draft.socks-port == root.draft.http-port);
    private property <bool> http-clash: root.draft.http-port > 0
        && (root.draft.http-port == root.draft.mixed-port || root.draft.http-port == root.draft.socks-port);

    // The MTU blocks Save only while TUN is on. A bad MTU with TUN off is still
    // flagged, but the last valid value is kept and saved.
    private property <bool> tun-mtu-ok: !root.draft.tun-enabled || root.ok-mtu;

    private property <bool> inputs-ok: root.ok-mixed && root.ok-socks && root.ok-http
        && !root.mixed-clash && !root.socks-clash && !root.http-clash
        && root.tun-mtu-ok
        && root.ok-keep-alive && root.ok-retention && root.ok-interval && root.ok-timeout;

    private property <bool> can-save: root.dirty && root.inputs-ok && !Bridge.busy;
    private property <string> save-blocker: !root.inputs-ok ? @tr("Fix the highlighted fields first.")
        : Bridge.busy ? @tr("Another operation is running.")
        : "";

    private property <bool> hk-can-save: root.hk-dirty && !Bridge.busy;

    // --- choices --------------------------------------------------------------

    private property <[SelectItem]> routing-items: Bridge.global-mode-allowed ? [
        { text: @tr("Rule-based"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Global"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Direct"), detail: "", detail-color: Design.muted-foreground },
    ] : [
        { text: @tr("Rule-based"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Direct"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> routing-values: Bridge.global-mode-allowed
        ? ["rule", "global", "direct"] : ["rule", "direct"];

    private property <[SelectItem]> log-items: [
        { text: @tr("Silent"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Error"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Warning"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Info"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Debug"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> log-values: ["silent", "error", "warning", "info", "debug"];

    // Minutes. 0 is manual only. -1 (unset) shows as the default, one hour.
    private property <[SelectItem]> refresh-items: [
        { text: @tr("Never"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("30 min"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("1 hour (default)"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("6 hours"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("12 hours"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("24 hours"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[int]> refresh-values: [0, 30, 60, 360, 720, 1440];

    private property <[string]> sysproxy-options: [@tr("Manual"), @tr("PAC script")];

    private property <[SelectItem]> stack-items: [
        { text: @tr("Default"), detail: "", detail-color: Design.muted-foreground },
        { text: "gVisor", detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Mixed"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("System"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> stack-values: ["", "gvisor", "mixed", "system"];

    private property <[SelectItem]> dns-mode-items: [
        { text: @tr("Default"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Fake IP"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Redir host"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> dns-mode-values: ["", "fake-ip", "redir-host"];

    private property <[SelectItem]> find-items: [
        { text: @tr("Default"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Off"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Strict"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Always"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> find-values: ["", "off", "strict", "always"];

    private property <[SelectItem]> geo-mode-items: [
        { text: @tr("Default"), detail: "", detail-color: Design.muted-foreground },
        { text: "DAT", detail: "", detail-color: Design.muted-foreground },
        { text: "MMDB", detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> geo-mode-values: ["", "dat", "mmdb"];

    private property <[SelectItem]> channel-items: [
        { text: @tr("Stable"), detail: "", detail-color: Design.muted-foreground },
        { text: @tr("Alpha"), detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> channel-values: ["stable", "alpha"];

    private property <[SelectItem]> language-items: [
        { text: @tr("System"), detail: "", detail-color: Design.muted-foreground },
        { text: "English", detail: "", detail-color: Design.muted-foreground },
        { text: "Русский", detail: "", detail-color: Design.muted-foreground },
    ];
    private property <[string]> language-values: ["", "en", "ru"];

    // Hotkey placeholders show the format; the row's description says how to clear one.
    private property <string> hotkey-example: "Ctrl+Alt+KeyS";

    // --- actions --------------------------------------------------------------

    // An unset value (-1) is the app default, which is one hour: index 2.
    function refresh-index-of(v: int) -> int {
        if (v < 0) { return 2; }
        if (v == 0) { return 0; }
        if (v == 30) { return 1; }
        if (v == 60) { return 2; }
        if (v == 360) { return 3; }
        if (v == 720) { return 4; }
        if (v == 1440) { return 5; }
        return -1;
    }

    // The date of a Unix time in UTC, as YYYY-MM-DD (civil-from-days, H. Hinnant's
    // algorithm), worked out in floats because Slint has no date functions.
    private property <float> geo-days: floor((Bridge.geo-updated-at * 1.0) / 86400.0) + 719468;
    private property <float> geo-era: floor(root.geo-days / 146097);
    private property <float> geo-doe: root.geo-days - root.geo-era * 146097;
    private property <float> geo-yoe: floor((root.geo-doe - floor(root.geo-doe / 1460)
        + floor(root.geo-doe / 36524) - floor(root.geo-doe / 146096)) / 365);
    private property <float> geo-doy: root.geo-doe - (365 * root.geo-yoe + floor(root.geo-yoe / 4)
        - floor(root.geo-yoe / 100));
    private property <float> geo-mp: floor((5 * root.geo-doy + 2) / 153);
    private property <float> geo-day: root.geo-doy - floor((153 * root.geo-mp + 2) / 5) + 1;
    private property <float> geo-month: root.geo-mp < 10 ? root.geo-mp + 3 : root.geo-mp - 9;
    private property <float> geo-year: root.geo-yoe + root.geo-era * 400
        + (root.geo-month <= 2 ? 1 : 0);

    function two-digits(n: float) -> string {
        if (n < 10) { return "0\{n}"; }
        return "\{n}";
    }

    private property <string> geo-text: Bridge.geo-updated-at <= 0 ? @tr("Never")
        : @tr("Last updated {} (UTC)", "\{root.geo-year}-\{root.two-digits(root.geo-month)}-\{root.two-digits(root.geo-day)}");

    // Rereads Bridge into the drafts. Discard calls this; a push from Rust
    // calls the change handlers below.
    function discard() {
        root.draft = Bridge.settings;
        root.edraft = Bridge.engine-settings;
        root.rev += 1;
    }

    function discard-hotkeys() {
        root.hk = Bridge.hotkeys;
        root.rev += 1;
    }

    function save-all() {
        if (root.core-dirty) {
            Bridge.save-settings(root.draft);
        }
        if (root.engine-dirty) {
            Bridge.save-engine-settings(root.edraft);
        }
    }

    changed pushed => {
        root.draft = Bridge.settings;
        root.rev += 1;
    }

    changed engine-pushed => {
        root.edraft = Bridge.engine-settings;
        root.rev += 1;
    }

    changed hotkeys-pushed => {
        root.hk = Bridge.hotkeys;
        root.rev += 1;
    }

    // --- layout ---------------------------------------------------------------

    // The section list, or one section. The save bar sits along the bottom
    // while anything is unsaved.
    scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - (root.dirty ? 57px : 0px);
        content-height: max(self.height, body.preferred-height);

        body := HorizontalLayout {
            vertical-stretch: 0;
            alignment: center;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 20px;
            padding-bottom: 24px;

            VerticalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                alignment: start;
                max-width: 920px;
                spacing: 0px;

                if (root.section < 0) : PageHeader {
                    title: @tr("Settings");
                    description: "";
                }

                // A section: the back button, then its name and what it holds.
                if (root.section >= 0) : HorizontalLayout {
                    padding-bottom: 20px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: start;

                        IconButton {
                            icon: @image-url("../assets/icons/arrow-left.svg");
                            size: ButtonSize.md;
                            variant: ButtonVariant.ghost;
                            tooltip: @tr("Back to settings");
                            clicked => {
                                root.open-section(-1);
                            }
                        }
                    }

                    PageHeader {
                        horizontal-stretch: 1;
                        padding-bottom: 0px;
                        title: root.section-names[root.section];
                        description: root.section-texts[root.section];
                    }
                }

                if (root.section < 0) : Card {
                    for name[i] in root.section-names : SectionLink {
                        icon: root.section-icons[i];
                        text: name;
                        description: root.section-texts[i];
                        clicked => {
                            root.open-section(i);
                        }
                    }
                }

                if (!Bridge.loaded) : Card {
                    EmptyState {
                        icon: @image-url("../assets/icons/loader-circle.svg");
                        title: @tr("Loading settings");
                        text: @tr("Waiting for the proxy engine to report its settings.");
                    }
                }

                // Errors from Save and from the switches are shown here when no
                // save bar is up. With a bar up, the bar shows the same message.
                if (Bridge.loaded && Bridge.settings-error != "" && !root.dirty) : VerticalLayout {
                    padding-bottom: 16px;

                    EmojiText {
                        runs: Bridge.settings-error-runs;
                        fallback: Bridge.settings-error;
                        font-size: Design.font-sm;
                        color: Design.destructive;
                        wrap: true;
                    }
                }

                // ============================================================
                // General
                // ============================================================
                if (Bridge.loaded && root.section == 0) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Interface");
                        }

                        SettingRow {
                            label: @tr("Language");
                            description: @tr("Applies to the whole app, including the tray.");

                            DraftChoice {
                                items: root.language-items;
                                values: root.language-values;
                                value: root.draft.language;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.language = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Startup");
                        }

                        SettingRow {
                            label: @tr("Start at login");
                            description: @tr("Starts Starpod when you log in.");

                            DraftSwitch {
                                value: root.draft.autostart;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.autostart = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Start in the tray");
                            description: @tr("A start at login stays in the tray instead of showing the window.");

                            DraftSwitch {
                                value: root.draft.silent-start;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.silent-start = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Close to tray");
                            description: @tr("Closing the window hides Starpod to the tray and the proxy keeps running. Off quits Starpod and stops the engine.");
                            warning: Bridge.tray-available ? "" : @tr("This desktop has no tray, so closing always quits.");

                            DraftSwitch {
                                value: root.draft.close-to-tray;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.close-to-tray = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Connect on start");
                            description: @tr("Connects once the saved state has loaded, when a subscription has servers.");

                            DraftSwitch {
                                value: root.draft.auto-connect;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.auto-connect = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Routing and subscriptions");
                        }

                        SettingRow {
                            label: @tr("Routing mode");
                            description: Bridge.global-mode-allowed
                                ? @tr("Rule-based follows your rules. Global sends everything through the selected server. Direct uses no proxy.")
                                : @tr("The active subscription does not allow Global. Rule-based follows your rules.");

                            DraftChoice {
                                items: root.routing-items;
                                values: root.routing-values;
                                value: root.draft.mode;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.mode = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Auto-update every");
                            description: @tr("How often subscriptions are refreshed in the background.");

                            DraftSelect {
                                items: root.refresh-items;
                                value: root.refresh-index-of(root.draft.auto-refresh-minutes);
                                revision: root.rev;
                                placeholder: @tr("Custom");
                                committed(i) => {
                                    root.draft.auto-refresh-minutes = root.refresh-values[i];
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Updates");
                        }

                        SettingRow {
                            label: @tr("Check for updates at startup");
                            description: @tr("Asks GitHub for a newer release when Starpod starts. Nothing is downloaded.");

                            DraftSwitch {
                                value: Bridge.check-updates;
                                revision: 0;
                                committed(v) => {
                                    // Set at once, and Rust pushes the stored value back after the save.
                                    Bridge.check-updates = v;
                                    Bridge.set-check-updates(v);
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Check now");
                            description: @tr("Looks for a newer release on GitHub.");

                            HorizontalLayout {
                                alignment: end;

                                Button {
                                    text: @tr("Check for updates");
                                    variant: ButtonVariant.outline;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        Bridge.check-for-updates();
                                    }
                                }
                            }
                        }

                        if (Bridge.update-available) : VerticalLayout {
                            Separator {}

                            SettingRow {
                                label: @tr("Update available");
                                description: @tr("Version {} is on GitHub. Installing it restarts Starpod.", Bridge.update-version);

                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 8px;

                                    Button {
                                        text: @tr("Release notes");
                                        variant: ButtonVariant.outline;
                                        clicked => {
                                            Bridge.open-url(Bridge.update-url);
                                        }
                                    }

                                    Button {
                                        text: @tr("Install update");
                                        variant: ButtonVariant.primary;
                                        busy: Bridge.busy;
                                        clicked => {
                                            Bridge.install-update();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Network
                // ============================================================
                if (Bridge.loaded && root.section == 1) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Ports");
                        }

                        SettingRow {
                            label: @tr("Mixed port");
                            description: @tr("HTTP and SOCKS5 on one port. Empty uses the default.");

                            DraftNumber {
                                value: root.draft.mixed-port;
                                revision: root.rev;
                                placeholder: "7890";
                                problem: root.mixed-clash ? @tr("Another listener already uses this port.") : "";
                                ok <=> root.ok-mixed;
                                committed(v) => {
                                    root.draft.mixed-port = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("SOCKS5 port");
                            description: @tr("SOCKS5 only. Empty uses the default.");

                            DraftNumber {
                                value: root.draft.socks-port;
                                revision: root.rev;
                                placeholder: @tr("Off");
                                problem: root.socks-clash ? @tr("Another listener already uses this port.") : "";
                                ok <=> root.ok-socks;
                                committed(v) => {
                                    root.draft.socks-port = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("HTTP port");
                            description: @tr("HTTP only. Empty turns it off.");

                            DraftNumber {
                                value: root.draft.http-port;
                                revision: root.rev;
                                placeholder: @tr("Off");
                                problem: root.http-clash ? @tr("Another listener already uses this port.") : "";
                                ok <=> root.ok-http;
                                committed(v) => {
                                    root.draft.http-port = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Access");
                        }

                        SettingRow {
                            label: @tr("Allow LAN");
                            description: @tr("Lets other devices on your network use the proxy.");
                            warning: root.draft.allow-lan ? @tr("Exposed: any device on your network can use it.") : "";

                            DraftSwitch {
                                value: root.draft.allow-lan;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.allow-lan = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Bind address");
                            description: root.draft.allow-lan
                                ? @tr("The address the listeners bind to. Empty uses 127.0.0.1.")
                                : @tr("Turn on Allow LAN to change the bind address.");

                            DraftText {
                                value: root.draft.bind-address;
                                revision: root.rev;
                                placeholder: "127.0.0.1";
                                enabled: root.draft.allow-lan;
                                committed(v) => {
                                    root.draft.bind-address = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("IPv6");
                            description: @tr("Default leaves the engine's choice.");

                            DraftTri {
                                value: root.edraft.ipv6;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.ipv6 = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("System proxy");
                        }

                        SettingRow {
                            label: @tr("Set the system proxy");
                            description: Bridge.system-proxy-active
                                ? @tr("Active. The system proxy points at Starpod.")
                                : @tr("Not active. The system proxy follows the engine while this is on.");

                            DraftSwitch {
                                value: root.draft.system-proxy;
                                revision: root.rev;
                                committed(v) => {
                                    // The draft is written too, so a later Save does not undo the change.
                                    root.draft.system-proxy = v;
                                    Bridge.toggle-system-proxy(v);
                                }
                            }
                        }

                        if (Bridge.system-proxy-error != "") : VerticalLayout {
                            padding-bottom: 12px;

                            Text {
                                text: Bridge.system-proxy-error;
                                color: Design.destructive;
                                font-family: Design.font-family;
                                font-size: Design.font-sm;
                                wrap: word-wrap;
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Proxy mode");
                            description: @tr("Manual points the system at one server. PAC uses a script that Starpod serves.");

                            DraftSegmented {
                                options: root.sysproxy-options;
                                value: root.draft.sysproxy-mode == "pac" ? 1 : 0;
                                revision: root.rev;
                                committed(i) => {
                                    root.draft.sysproxy-mode = i == 1 ? "pac" : "manual";
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Bypass list");
                            description: @tr("Hosts the proxy is skipped for, in the operating system's syntax. Used in manual mode.");

                            DraftList {
                                value: root.draft.sysproxy-bypass;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.sysproxy-bypass = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("PAC script");
                            description: @tr("The script for PAC mode. %mixed-port% stands for the engine's mixed port.");

                            DraftList {
                                value: root.draft.pac-script;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.pac-script = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Terminal");
                        }

                        SettingRow {
                            label: @tr("Proxy command");
                            description: @tr("Copies the command that points a terminal at Starpod's ports.");

                            HorizontalLayout {
                                alignment: end;

                                Button {
                                    text: @tr("Copy proxy command");
                                    variant: ButtonVariant.outline;
                                    clicked => {
                                        Bridge.copy-proxy-env();
                                    }
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // TUN
                // ============================================================
                if (Bridge.loaded && root.section == 2) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Adapter");
                        }

                        SettingRow {
                            label: @tr("Enable TUN");
                            description: @tr("Routes all system traffic. Needs administrator rights.");

                            DraftSwitch {
                                value: root.draft.tun-enabled;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.tun-enabled = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Device name");
                            description: @tr("The name of the virtual adapter. Empty uses the engine default.");

                            DraftText {
                                value: root.draft.tun-device;
                                revision: root.rev;
                                placeholder: @tr("Automatic");
                                committed(v) => {
                                    root.draft.tun-device = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("MTU");
                            description: @tr("Largest packet size in bytes. Empty uses the engine default.");

                            DraftNumber {
                                value: root.draft.tun-mtu;
                                revision: root.rev;
                                low: 1280;
                                high: 9000;
                                placeholder: "9000";
                                hint: "1280–9000";
                                ok <=> root.ok-mtu;
                                committed(v) => {
                                    root.draft.tun-mtu = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Stack");
                            description: @tr("How the engine handles the packets that TUN captures.");

                            DraftChoice {
                                items: root.stack-items;
                                values: root.stack-values;
                                value: root.edraft.tun-stack;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-stack = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Routes");
                        }

                        SettingRow {
                            label: @tr("Auto route");
                            description: @tr("Installs the routes when TUN starts. Off leaves the routes to you.");

                            DraftSwitch {
                                value: root.draft.tun-auto-route;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.tun-auto-route = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("DNS hijack");
                            description: @tr("DNS queries to these targets go to the engine, one host:port per line, such as any:53. Empty uses the engine default.");

                            DraftList {
                                value: root.draft.tun-dns-hijack;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.tun-dns-hijack = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Strict route");
                            description: @tr("Keeps traffic that is outside the TUN routes from leaving the adapter.");

                            DraftTri {
                                value: root.edraft.tun-strict-route;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-strict-route = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Auto redirect");
                            description: @tr("Forwards traffic through an automatic redirect where the platform supports one.");

                            DraftTri {
                                value: root.edraft.tun-auto-redirect;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-auto-redirect = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Auto-detect interface");
                            description: @tr("Finds the network interface that carries outbound traffic by itself.");

                            DraftTri {
                                value: root.edraft.tun-auto-detect-interface;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-auto-detect-interface = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Endpoint-independent NAT");
                            description: @tr("Keeps one UDP mapping per source port, whatever the destination.");

                            DraftTri {
                                value: root.edraft.tun-endpoint-independent-nat;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-endpoint-independent-nat = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Included routes");
                            description: @tr("CIDR ranges sent through TUN, one per line. Empty uses the engine's routes.");

                            DraftList {
                                value: root.edraft.tun-route-address;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-route-address = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Excluded routes");
                            description: @tr("CIDR ranges that stay off TUN, one per line.");

                            DraftList {
                                value: root.edraft.tun-route-exclude-address;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tun-route-exclude-address = v;
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // DNS
                // ============================================================
                if (Bridge.loaded && root.section == 3) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("DNS server");
                        }

                        SettingRow {
                            label: @tr("Replace the subscription's DNS");
                            description: @tr("Uses the DNS settings below instead of the ones the subscription sends.");

                            DraftSwitch {
                                value: root.edraft.override-dns;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.override-dns = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Enable DNS server");
                            description: @tr("Runs the engine's own DNS server.");

                            DraftTri {
                                value: root.edraft.dns-enable;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-enable = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Enhanced mode");
                            description: @tr("Fake IP answers with addresses from a private range. Redir host answers with real ones.");

                            DraftChoice {
                                items: root.dns-mode-items;
                                values: root.dns-mode-values;
                                value: root.edraft.dns-enhanced-mode;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-enhanced-mode = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Fake IP range");
                            description: @tr("The CIDR range that fake addresses come from. Empty uses the engine default.");

                            DraftText {
                                value: root.edraft.dns-fake-ip-range;
                                revision: root.rev;
                                placeholder: "198.18.0.1/16";
                                committed(v) => {
                                    root.edraft.dns-fake-ip-range = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Fake IP filter");
                            description: @tr("Domains that always get a real address, one per line.");

                            DraftList {
                                value: root.edraft.dns-fake-ip-filter;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-fake-ip-filter = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Upstream servers");
                        }

                        ListRow {
                            label: @tr("Nameservers");
                            description: @tr("The servers the DNS server asks, one per line.");

                            DraftList {
                                value: root.edraft.dns-nameserver;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-nameserver = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Fallback servers");
                            description: @tr("Servers asked when the nameservers fail, one per line.");

                            DraftList {
                                value: root.edraft.dns-fallback;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-fallback = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Default nameservers");
                            description: @tr("Plain IP servers that resolve the names of the other servers, one per line.");

                            DraftList {
                                value: root.edraft.dns-default-nameserver;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-default-nameserver = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Proxy server nameservers");
                            description: @tr("Servers used to resolve the names of proxy servers, one per line.");

                            DraftList {
                                value: root.edraft.dns-proxy-server-nameserver;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-proxy-server-nameserver = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Nameserver policy");
                            description: @tr("Which servers answer for which domains, one per line: domain: server, server.");

                            DraftList {
                                value: root.edraft.dns-nameserver-policy;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-nameserver-policy = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Hosts");
                        }

                        SettingRow {
                            label: @tr("Use hosts");
                            description: @tr("Answers names from the hosts list below.");

                            DraftTri {
                                value: root.edraft.dns-use-hosts;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.dns-use-hosts = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Hosts");
                            description: @tr("One entry per line: domain ip.");

                            DraftList {
                                value: root.edraft.hosts;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.hosts = v;
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Sniffer
                // ============================================================
                if (Bridge.loaded && root.section == 4) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Sniffer");
                        }

                        SettingRow {
                            label: @tr("Enable sniffer");
                            description: @tr("Reads the domain name from the first bytes of TLS and HTTP traffic.");

                            DraftTri {
                                value: root.edraft.sniffer-enable;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-enable = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Force DNS mapping");
                            description: @tr("Uses the DNS mapping to name connections that have only an address.");

                            DraftTri {
                                value: root.edraft.sniffer-force-dns-mapping;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-force-dns-mapping = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Parse pure IP");
                            description: @tr("Sniffs connections that were opened to a bare IP address.");

                            DraftTri {
                                value: root.edraft.sniffer-parse-pure-ip;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-parse-pure-ip = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Override destination");
                            description: @tr("Replaces the address with the sniffed domain name.");

                            DraftTri {
                                value: root.edraft.sniffer-override-destination;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-override-destination = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Protocols and domains");
                        }

                        ListRow {
                            label: @tr("Sniff protocols");
                            description: @tr("One per line: a protocol and its ports, for example HTTP: 80, 8080-8880.");

                            DraftList {
                                value: root.edraft.sniffer-sniff;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-sniff = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Force domains");
                            description: @tr("Domains to sniff even when the sniffer would skip them, one per line.");

                            DraftList {
                                value: root.edraft.sniffer-force-domain;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-force-domain = v;
                                }
                            }
                        }

                        Separator {}

                        ListRow {
                            label: @tr("Skip domains");
                            description: @tr("Domains the sniffer leaves alone, one per line.");

                            DraftList {
                                value: root.edraft.sniffer-skip-domain;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.sniffer-skip-domain = v;
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Geo data
                // ============================================================
                if (Bridge.loaded && root.section == 5) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Databases");
                        }

                        SettingRow {
                            label: @tr("Format");
                            description: @tr("The database format the engine reads.");

                            DraftChoice {
                                items: root.geo-mode-items;
                                values: root.geo-mode-values;
                                value: root.edraft.geodata-mode;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.geodata-mode = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("GeoIP source");
                            description: @tr("A URL. Empty uses the default source.");

                            DraftText {
                                value: root.edraft.geox-geoip;
                                revision: root.rev;
                                placeholder: @tr("Default source");
                                committed(v) => {
                                    root.edraft.geox-geoip = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("GeoSite source");
                            description: @tr("A URL. Empty uses the default source.");

                            DraftText {
                                value: root.edraft.geox-geosite;
                                revision: root.rev;
                                placeholder: @tr("Default source");
                                committed(v) => {
                                    root.edraft.geox-geosite = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("MMDB source");
                            description: @tr("A URL. Empty uses the default source.");

                            DraftText {
                                value: root.edraft.geox-mmdb;
                                revision: root.rev;
                                placeholder: @tr("Default source");
                                committed(v) => {
                                    root.edraft.geox-mmdb = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("ASN source");
                            description: @tr("A URL. Empty uses the default source.");

                            DraftText {
                                value: root.edraft.geox-asn;
                                revision: root.rev;
                                placeholder: @tr("Default source");
                                committed(v) => {
                                    root.edraft.geox-asn = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Updates");
                        }

                        SettingRow {
                            label: @tr("Update automatically");
                            description: @tr("Refreshes the databases in the background.");

                            DraftTri {
                                value: root.edraft.geodata-auto-update;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.geodata-auto-update = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Update every");
                            description: @tr("Hours between automatic refreshes. Empty uses the app default.");

                            DraftNumber {
                                value: root.edraft.geodata-update-interval-hours;
                                revision: root.rev;
                                low: 1;
                                high: 8760;
                                placeholder: "24";
                                hint: @tr("Hours");
                                ok <=> root.ok-interval;
                                committed(v) => {
                                    root.edraft.geodata-update-interval-hours = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Refresh now");
                            description: root.geo-text;

                            HorizontalLayout {
                                alignment: end;

                                Button {
                                    text: @tr("Update now");
                                    variant: ButtonVariant.outline;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        Bridge.update-geo-data();
                                    }
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Engine
                // ============================================================
                if (Bridge.loaded && root.section == 6) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Version");
                        }

                        SettingRow {
                            label: @tr("Installed");
                            description: !Bridge.engine-installed ? @tr("Not installed")
                                : Bridge.engine-installed-version != "" ? Bridge.engine-installed-version
                                : Bridge.engine-version != "" ? Bridge.engine-version
                                : @tr("Installed");

                            HorizontalLayout {
                                alignment: end;

                                Button {
                                    text: Bridge.engine-installed ? @tr("Reinstall") : @tr("Install");
                                    variant: ButtonVariant.outline;
                                    busy: Bridge.busy;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        Bridge.install-engine();
                                    }
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Channel");
                            description: @tr("Alpha releases come first and may be less stable.");

                            DraftChoice {
                                items: root.channel-items;
                                values: root.channel-values;
                                value: root.edraft.engine-channel;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.engine-channel = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Latest");
                            description: Bridge.engine-latest-version == "" ? @tr("Not checked yet")
                                : Bridge.engine-update-available ? @tr("Version {} is available on this channel", Bridge.engine-latest-version)
                                : @tr("Up to date on this channel");

                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;

                                Button {
                                    text: @tr("Check");
                                    variant: ButtonVariant.outline;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        Bridge.check-engine-update();
                                    }
                                }

                                if (Bridge.engine-update-available) : Button {
                                    text: @tr("Upgrade");
                                    variant: ButtonVariant.primary;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        Bridge.upgrade-engine();
                                    }
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Logs and tests");
                        }

                        SettingRow {
                            label: @tr("Log level");
                            description: @tr("How much the engine writes to the Logs screen.");

                            DraftChoice {
                                items: root.log-items;
                                values: root.log-values;
                                value: root.draft.log-level;
                                revision: root.rev;
                                placeholder: @tr("Choose");
                                committed(v) => {
                                    root.draft.log-level = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Log retention");
                            description: @tr("Lines kept on the Logs screen. Empty uses the app default.");

                            DraftNumber {
                                value: root.edraft.log-retention-lines;
                                revision: root.rev;
                                low: 100;
                                high: 2000;
                                placeholder: "1000";
                                hint: @tr("Lines");
                                ok <=> root.ok-retention;
                                committed(v) => {
                                    root.edraft.log-retention-lines = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Delay test URL");
                            description: @tr("The address latency tests request. Empty uses the app default.");

                            DraftText {
                                value: root.edraft.delay-test-url;
                                revision: root.rev;
                                placeholder: "https://www.gstatic.com/generate_204";
                                committed(v) => {
                                    root.edraft.delay-test-url = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Delay test timeout");
                            description: @tr("How long a latency test waits for an answer. Empty uses the app default.");

                            DraftNumber {
                                value: root.edraft.delay-test-timeout-ms;
                                revision: root.rev;
                                low: 1;
                                high: 600000;
                                placeholder: "5000";
                                hint: @tr("ms");
                                ok <=> root.ok-timeout;
                                committed(v) => {
                                    root.edraft.delay-test-timeout-ms = v;
                                }
                            }
                        }
                    }

                    Card {
                        CardHeader {
                            title: @tr("Connections");
                        }

                        SettingRow {
                            label: @tr("Find process");
                            description: @tr("When the engine names the program behind a connection.");

                            DraftChoice {
                                items: root.find-items;
                                values: root.find-values;
                                value: root.edraft.find-process-mode;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.find-process-mode = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Unified delay");
                            description: @tr("Measures latency after the first handshake, so the results compare fairly.");

                            DraftTri {
                                value: root.edraft.unified-delay;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.unified-delay = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("TCP concurrent");
                            description: @tr("Tries several addresses at once to connect faster.");

                            DraftTri {
                                value: root.edraft.tcp-concurrent;
                                revision: root.rev;
                                committed(v) => {
                                    root.edraft.tcp-concurrent = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Keep-alive interval");
                            description: @tr("How often idle connections are probed, in seconds. Empty uses the engine default.");

                            DraftNumber {
                                value: root.edraft.keep-alive-interval;
                                revision: root.rev;
                                low: 1;
                                high: 86400;
                                placeholder: @tr("Default");
                                hint: @tr("Seconds");
                                ok <=> root.ok-keep-alive;
                                committed(v) => {
                                    root.edraft.keep-alive-interval = v;
                                }
                            }
                        }

                    }
                }

                // ============================================================
                // Proxies
                // ============================================================
                if (Bridge.loaded && root.section == 7) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Proxy groups");
                        }

                        SettingRow {
                            label: @tr("Close connections on switch");
                            description: @tr("When you pick a server in a group, closes the connections that went through the old one.");

                            DraftSwitch {
                                value: root.draft.auto-close-connections-on-switch;
                                revision: root.rev;
                                committed(v) => {
                                    root.draft.auto-close-connections-on-switch = v;
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Privacy
                // ============================================================
                if (Bridge.loaded && root.section == 8) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Device identification");
                        }

                        SettingRow {
                            label: @tr("Send device identification");
                            description: @tr("With each subscription request, sends a device ID, the operating system, its version and the device model, so the provider can count your devices. Off sends none of them.");

                            DraftSwitch {
                                value: Bridge.send-device-id;
                                revision: 0;
                                committed(v) => {
                                    // Set at once, and Rust pushes the stored value back after the save.
                                    Bridge.send-device-id = v;
                                    Bridge.set-send-device-id(v);
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Hotkeys
                // ============================================================
                if (Bridge.loaded && root.section == 9) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Global shortcuts");
                            description: @tr("They work from any app. Write them as Ctrl+Alt+KeyS. Empty turns a shortcut off.");
                        }

                        SettingRow {
                            label: @tr("Show the window");
                            description: @tr("Brings the Starpod window to the front.");

                            DraftText {
                                value: root.hk.show-window;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.show-window = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Connect or disconnect");
                            description: @tr("Starts or stops the engine.");

                            DraftText {
                                value: root.hk.toggle-connect;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.toggle-connect = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Turn the system proxy on or off");
                            description: @tr("Changes the system proxy setting.");

                            DraftText {
                                value: root.hk.toggle-system-proxy;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.toggle-system-proxy = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Rule-based mode");
                            description: @tr("Switches the routing mode.");

                            DraftText {
                                value: root.hk.mode-rule;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.mode-rule = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Global mode");
                            description: @tr("Switches the routing mode.");

                            DraftText {
                                value: root.hk.mode-global;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.mode-global = v;
                                }
                            }
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Direct mode");
                            description: @tr("Switches the routing mode.");

                            DraftText {
                                value: root.hk.mode-direct;
                                revision: root.rev;
                                placeholder: root.hotkey-example;
                                committed(v) => {
                                    root.hk.mode-direct = v;
                                }
                            }
                        }

                        if (Bridge.settings-error != "") : VerticalLayout {
                            padding-top: 12px;

                            EmojiText {
                                runs: Bridge.settings-error-runs;
                                fallback: Bridge.settings-error;
                                font-size: Design.font-sm;
                                color: Design.destructive;
                                wrap: true;
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            padding-top: 12px;

                            Button {
                                text: @tr("Discard");
                                variant: ButtonVariant.ghost;
                                enabled: root.hk-dirty && !Bridge.busy;
                                clicked => {
                                    root.discard-hotkeys();
                                }
                            }

                            Button {
                                text: @tr("Save shortcuts");
                                variant: ButtonVariant.primary;
                                enabled: root.hk-can-save;
                                busy: Bridge.busy;
                                clicked => {
                                    Bridge.save-hotkeys(root.hk);
                                }
                            }
                        }
                    }
                }

                // ============================================================
                // Storage
                // ============================================================
                if (Bridge.loaded && root.section == 10) : VerticalLayout {
                    spacing: 16px;

                    Card {
                        CardHeader {
                            title: @tr("Storage");
                        }

                        SettingRow {
                            label: @tr("Secrets stored in");
                            description: (Bridge.secret-backend != "" ? Bridge.secret-backend : @tr("Not reported yet"))
                                + (Bridge.secrets-encrypted || Bridge.secret-fallback-reason == "" ? "" : ". " + Bridge.secret-fallback-reason);
                            warning: Bridge.secrets-encrypted ? "" : @tr("Not encrypted. Anyone with access to your user profile can read them.");
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Data folder");
                            description: Bridge.data-dir != "" ? Bridge.data-dir : @tr("Not reported yet");
                        }

                        Separator {}

                        SettingRow {
                            label: @tr("Cached profiles");
                            description: @tr("Removes downloaded subscription content. It is fetched again on the next refresh.");

                            HorizontalLayout {
                                alignment: end;

                                Button {
                                    text: @tr("Clear");
                                    variant: ButtonVariant.destructive-outline;
                                    enabled: !Bridge.busy;
                                    clicked => {
                                        clear-dialog.show();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // --- save bar: only while a draft differs from Bridge ----------------------
    // 56px plus a 1px top border. A long error wraps to two lines inside it.
    if (root.dirty) : Rectangle {
        x: 0px;
        y: parent.height - 57px;
        width: parent.width;
        height: 57px;
        background: Design.card;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: Design.border;
        }

        bar := HorizontalLayout {
            x: 0px;
            y: 1px;
            width: parent.width;
            height: parent.height - 1px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                if (Bridge.settings-error != "") : EmojiText {
                    runs: Bridge.settings-error-runs;
                    fallback: Bridge.settings-error;
                    font-size: Design.font-sm;
                    font-weight: 500;
                    color: Design.destructive;
                    wrap: true;
                }

                if (Bridge.settings-error == "") : Text {
                    text: root.save-blocker != "" ? root.save-blocker : @tr("You have unsaved changes.");
                    color: root.save-blocker != "" ? Design.warning : Design.foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-sm;
                    font-weight: 500;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                alignment: center;

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        text: @tr("Discard");
                        variant: ButtonVariant.ghost;
                        enabled: !Bridge.busy;
                        clicked => {
                            root.discard();
                        }
                    }

                    Button {
                        text: @tr("Save");
                        variant: ButtonVariant.primary;
                        enabled: root.can-save;
                        busy: Bridge.busy;
                        clicked => {
                            root.save-all();
                        }
                    }
                }
            }
        }
    }

    clear-dialog := ConfirmDialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Clear cached profiles?");
        message: @tr("This deletes the downloaded subscription content. Your subscriptions stay configured.");
        confirm-text: @tr("Clear cache");
        busy: Bridge.busy;
        confirmed => {
            clear-dialog.close();
            Bridge.clear-cache();
        }
    }
}
