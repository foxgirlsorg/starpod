// The Settings screen (ARCHITECTURE §6.2, §4.5).
//
// The page edits a private copy of Bridge.settings. Nothing reaches Rust
// until "Save", which hands the whole copy to Bridge.save-settings. "Discard"
// throws the copy away and reads Bridge.settings again. The checks here only
// keep bad input out of the copy and disable Save; the authoritative
// validation stays in Rust.

import { ScrollView } from "std-widgets.slint";
import { Design } from "../design.slint";
import { Bridge, SettingsModel } from "../bridge.slint";
import { AppButton, ButtonVariant, ButtonSize, Card, Badge, BadgeVariant, Field, FieldKind, AppSelect, SectionHeading, SettingRow, LoadingState, EmptyState } from "../primitives.slint";
import { IconTriangleAlert } from "../icons.slint";

// ---------------------------------------------------------------------------
// Local building blocks
// ---------------------------------------------------------------------------

// A label and an optional explanation on the left, a control on the right.
// The control column has a fixed width, and both columns are centred
// vertically on the row. SettingRow has no slot for a control, so the
// editable rows use this.
component ControlRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in property <length> control-width: 220px;
    spacing: Design.space-lg;

    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            color: Design.foreground;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            font-weight: 500;
            wrap: word-wrap;
        }

        if (root.description != "") : Text {
            text: root.description;
            color: Design.muted-foreground;
            font-family: Design.font-family;
            font-size: Design.font-xs;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        width: root.control-width;
        horizontal-stretch: 0;
        vertical-stretch: 0;
        alignment: center;

        @children
    }
}

// An on/off switch. The caller binds `checked` and handles `toggled`.
component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Design.primary : Design.secondary;
    border-width: 1px;
    border-color: Design.input;
    opacity: root.enabled ? 1 : 0.5;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: (parent.height - self.height) / 2;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        background: Design.foreground;
        animate x { duration: 120ms; }
    }

    focus-scope := FocusScope {
        enabled: root.enabled;
        focus-on-click: true;

        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.toggled(!root.checked);
                return accept;
            }
            return reject;
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => {
                root.toggled(!root.checked);
            }
        }
    }

    // The focus ring, the same halo the buttons use.
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 14px;
        border-width: 3px;
        border-color: Design.ring;
        opacity: 0.5;
        visible: focus-scope.has-focus;
    }
}

// ---------------------------------------------------------------------------
// The page
// ---------------------------------------------------------------------------

export component SettingsPage inherits VerticalLayout {
    padding: Design.space-xl;
    spacing: Design.space-lg;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    // The editable copy. It starts as a binding to Bridge.settings. The first
    // edit breaks that binding, and "Discard" or a fresh push from Rust
    // re-syncs it.
    private property <SettingsModel> draft: Bridge.settings;

    // The text in the number fields. Text is kept separately so that a value
    // which is not a number can be shown and flagged without being stored.
    // A number that is not set (-1 in the model) is shown as an empty field.
    private property <string> t-mixed: root.num-text(Bridge.settings.mixed-port);
    private property <string> t-socks: root.num-text(Bridge.settings.socks-port);
    private property <string> t-http: root.num-text(Bridge.settings.http-port);
    private property <string> t-mtu: root.num-text(Bridge.settings.tun-mtu);
    private property <string> t-refresh: root.num-text(Bridge.settings.auto-refresh-minutes);
    // The two text fields that edit the draft directly. Their own text is
    // kept here too, so a Field that has been typed in still follows a resync.
    private property <string> t-bind: Bridge.settings.bind-address;
    private property <string> t-device: Bridge.settings.tun-device;

    // A private mirror of Bridge.settings. Its `changed` handler fires when
    // Rust pushes new settings, for example after a successful save.
    private property <SettingsModel> pushed: Bridge.settings;

    private property <bool> confirm-clear: false;

    private property <[string]> mode-choices: ["rule", "global", "direct"];
    private property <[string]> log-choices: ["silent", "error", "warning", "info", "debug"];

    // --- checks ---------------------------------------------------------------

    function valid-int(s: string, lo: int, hi: int) -> bool {
        return s != "" && s.is-float() && s.to-float() == round(s.to-float())
            && s.to-float() >= lo && s.to-float() <= hi;
    }

    // Empty is valid for an optional number: it means "not set".
    function valid-optional(s: string, lo: int, hi: int) -> bool {
        return s == "" || root.valid-int(s, lo, hi);
    }

    // -1 is "not set" in the model and shows as an empty field.
    function num-text(v: int) -> string {
        return v < 0 ? "" : "\{v}";
    }

    // A port is 1 to 65535. Empty uses the default (HTTP: off). 0 is refused:
    // it is not a way to turn a listener off.
    private property <bool> ok-mixed: root.valid-optional(root.t-mixed, 1, 65535);
    private property <bool> ok-socks: root.valid-optional(root.t-socks, 1, 65535);
    private property <bool> ok-http: root.valid-optional(root.t-http, 1, 65535);
    // 1280 is the IPv6 minimum. TUN carries IPv6, and a smaller MTU breaks it.
    // The app refuses anything outside 1280-9000 (MIN_TUN_MTU and MAX_TUN_MTU in
    // ui/mapping.rs); keep both in step. Empty means the engine default.
    private property <bool> ok-mtu: root.valid-optional(root.t-mtu, 1280, 9000);
    // 0 is manual refresh only; empty means the app default.
    private property <bool> ok-refresh: root.valid-optional(root.t-refresh, 0, 10080);

    // An unset port (-1) is not a listener, so it cannot clash.
    private property <bool> mixed-clash: root.draft.mixed-port > 0
        && (root.draft.mixed-port == root.draft.socks-port || root.draft.mixed-port == root.draft.http-port);
    private property <bool> socks-clash: root.draft.socks-port > 0
        && (root.draft.socks-port == root.draft.mixed-port || root.draft.socks-port == root.draft.http-port);
    private property <bool> http-clash: root.draft.http-port > 0
        && (root.draft.http-port == root.draft.mixed-port || root.draft.http-port == root.draft.socks-port);

    // An empty bind address is the default (loopback). Any other text is
    // passed to the engine as it is, as it was before.
    // The TUN fields block Save only while TUN is on. A bad MTU with TUN off
    // is still flagged, but the last valid value is kept and saved.
    private property <bool> tun-name-ok: !root.draft.tun-enabled || root.draft.tun-device != "";
    private property <bool> tun-mtu-ok: !root.draft.tun-enabled || root.ok-mtu;

    private property <bool> inputs-ok: root.ok-mixed && root.ok-socks && root.ok-http
        && root.ok-refresh
        && !root.mixed-clash && !root.socks-clash && !root.http-clash
        && root.tun-mtu-ok && root.tun-name-ok;

    private property <bool> dirty: root.draft != Bridge.settings;
    private property <bool> can-save: root.dirty && root.inputs-ok && !Bridge.busy;
    private property <string> save-blocker: !root.dirty ? "There are no changes to save."
        : Bridge.busy ? "Another operation is running. Wait for it to finish."
        : !root.inputs-ok ? "Fix the highlighted fields first."
        : "";

    // --- actions --------------------------------------------------------------

    function resync() {
        root.draft = Bridge.settings;
        root.t-mixed = root.num-text(Bridge.settings.mixed-port);
        root.t-socks = root.num-text(Bridge.settings.socks-port);
        root.t-http = root.num-text(Bridge.settings.http-port);
        root.t-mtu = root.num-text(Bridge.settings.tun-mtu);
        root.t-refresh = root.num-text(Bridge.settings.auto-refresh-minutes);
        root.t-bind = Bridge.settings.bind-address;
        root.t-device = Bridge.settings.tun-device;
    }

    // Empty stores "not set" (-1). A valid number is stored. Anything else
    // leaves the draft as it was, and the field shows the error.
    function edit-mixed(text: string) {
        root.t-mixed = text;
        if (text == "") { root.draft.mixed-port = -1; }
        else if (root.valid-int(text, 1, 65535)) { root.draft.mixed-port = round(text.to-float()); }
    }

    function edit-socks(text: string) {
        root.t-socks = text;
        if (text == "") { root.draft.socks-port = -1; }
        else if (root.valid-int(text, 1, 65535)) { root.draft.socks-port = round(text.to-float()); }
    }

    function edit-http(text: string) {
        root.t-http = text;
        if (text == "") { root.draft.http-port = -1; }
        else if (root.valid-int(text, 1, 65535)) { root.draft.http-port = round(text.to-float()); }
    }

    function edit-mtu(text: string) {
        root.t-mtu = text;
        if (text == "") { root.draft.tun-mtu = -1; }
        else if (root.valid-int(text, 1280, 9000)) { root.draft.tun-mtu = round(text.to-float()); }
    }

    function edit-refresh(text: string) {
        root.t-refresh = text;
        if (text == "") { root.draft.auto-refresh-minutes = -1; }
        else if (root.valid-int(text, 0, 10080)) { root.draft.auto-refresh-minutes = round(text.to-float()); }
    }

    changed pushed => {
        root.resync();
    }

    // --- layout ---------------------------------------------------------------

    SectionHeading {
        eyebrow: "Configuration";
        title: "Settings";
        description: "Ports, network exposure, logging, TUN and the engine.";
        vertical-stretch: 0;
    }

    if (!Bridge.loaded) : LoadingState {
        vertical-stretch: 1;
        message: "Waiting for the proxy engine to report its settings…";
    }

    // The scroll area sits between the heading and the footer. The std
    // ScrollView asks for 100% of its parent as its preferred height, and the
    // parent here is this page, whose own height is built from its children.
    // That request feeds back on itself, so the scroll area collapsed and the
    // footer fell out of view. Ask for no preferred height and let the stretch
    // give the scroll area the room the heading and footer leave.
    if (Bridge.loaded) : ScrollView {
        preferred-height: 0px;
        vertical-stretch: 1;

        VerticalLayout {
            width: parent.width;
            spacing: Design.space-lg;
            padding-right: Design.space-md;

            // --- Proxy ----------------------------------------------------------
            Card {
                title: "Proxy";
                description: "Local listeners. An empty port uses its default. HTTP is off when empty.";

                ControlRow {
                    label: "Mixed port";
                    description: "HTTP and SOCKS5 on one port. Empty uses the default.";

                    Field {
                        kind: FieldKind.number;
                        placeholder: "7890";
                        value <=> root.t-mixed;
                        error: !root.ok-mixed ? "Enter a port from 1 to 65535, or leave it empty."
                            : root.mixed-clash ? "Another listener already uses this port." : "";
                        edited(text) => {
                            root.edit-mixed(text);
                        }
                    }
                }

                ControlRow {
                    label: "SOCKS5 port";
                    description: "SOCKS5 only. Empty uses the default.";

                    Field {
                        kind: FieldKind.number;
                        placeholder: "7891";
                        value <=> root.t-socks;
                        error: !root.ok-socks ? "Enter a port from 1 to 65535, or leave it empty."
                            : root.socks-clash ? "Another listener already uses this port." : "";
                        edited(text) => {
                            root.edit-socks(text);
                        }
                    }
                }

                ControlRow {
                    label: "HTTP port";
                    description: "HTTP only. Empty turns it off.";

                    Field {
                        kind: FieldKind.number;
                        placeholder: "off";
                        value <=> root.t-http;
                        error: !root.ok-http ? "Enter a port from 1 to 65535, or leave it empty."
                            : root.http-clash ? "Another listener already uses this port." : "";
                        edited(text) => {
                            root.edit-http(text);
                        }
                    }
                }

                ControlRow {
                    label: "Bind address";
                    description: "The address the listeners bind to. Empty uses the default, loopback.";

                    Field {
                        kind: FieldKind.text;
                        placeholder: "127.0.0.1";
                        value <=> root.t-bind;
                        edited(text) => {
                            root.draft.bind-address = text;
                        }
                    }
                }

                ControlRow {
                    label: "Allow LAN";
                    description: root.draft.allow-lan
                        ? "Exposes the proxy to your local network. Any device on that network can use it."
                        : "Only this computer can use the proxy.";

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Design.space-sm;
                        alignment: end;

                        if (root.draft.allow-lan) : Badge {
                            text: "Exposed";
                            variant: BadgeVariant.warning;
                            width: 72px;
                        }

                        ToggleSwitch {
                            checked: root.draft.allow-lan;
                            toggled(v) => {
                                root.draft.allow-lan = v;
                            }
                        }
                    }
                }

                ControlRow {
                    label: "Routing mode";
                    description: "Rule follows your rules, Global sends everything through the proxy, Direct bypasses it.";

                    AppSelect {
                        options: root.mode-choices;
                        value: root.draft.mode;
                        selected(v) => {
                            root.draft.mode = v;
                        }
                    }
                }

                ControlRow {
                    label: "Log level";
                    description: "How much the engine writes to the Logs screen.";

                    AppSelect {
                        options: root.log-choices;
                        value: root.draft.log-level;
                        selected(v) => {
                            root.draft.log-level = v;
                        }
                    }
                }
            }

            // --- TUN ------------------------------------------------------------
            Card {
                title: "TUN";
                description: "A virtual network adapter that sends all device traffic through the proxy.";

                HorizontalLayout {
                    spacing: Design.space-sm;

                    IconTriangleAlert {
                        width: 16px;
                        height: 16px;
                        y: 2px;
                        stroke: Design.warning;
                        stroke-width: 2px;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: "TUN needs administrator rights on Windows, or root on Linux and macOS. Starpod asks for elevation when TUN starts.";
                        color: Design.warning;
                        font-family: Design.font-family;
                        font-size: Design.font-xs;
                        wrap: word-wrap;
                    }
                }

                ControlRow {
                    label: "Enable TUN";
                    description: "Off by default. Turning it on triggers the elevation prompt.";

                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: end;

                        ToggleSwitch {
                            checked: root.draft.tun-enabled;
                            toggled(v) => {
                                root.draft.tun-enabled = v;
                            }
                        }
                    }
                }

                ControlRow {
                    label: "Device name";
                    description: "The name of the adapter. Required while TUN is enabled.";

                    Field {
                        kind: FieldKind.text;
                        placeholder: "starpod-tun";
                        value <=> root.t-device;
                        error: root.tun-name-ok ? "" : "Enter a device name, or turn TUN off.";
                        edited(text) => {
                            root.draft.tun-device = text;
                        }
                    }
                }

                ControlRow {
                    label: "MTU";
                    description: "Maximum packet size in bytes, from 1280 to 9000. Empty uses the engine default. 1280 is the smallest size IPv6 allows.";

                    Field {
                        kind: FieldKind.number;
                        placeholder: "default";
                        value <=> root.t-mtu;
                        error: root.ok-mtu ? "" : "Enter a whole number from 1280 to 9000, or leave it empty.";
                        edited(text) => {
                            root.edit-mtu(text);
                        }
                    }
                }
            }

            // --- Subscriptions --------------------------------------------------
            Card {
                title: "Subscriptions";
                description: "How subscriptions are kept up to date.";

                ControlRow {
                    label: "Auto refresh (minutes)";
                    description: "0 means manual refresh only. Empty uses the default of 60. The maximum is one week.";

                    Field {
                        kind: FieldKind.number;
                        placeholder: "60";
                        value <=> root.t-refresh;
                        error: root.ok-refresh ? "" : "Enter a whole number from 0 to 10080, or leave it empty.";
                        edited(text) => {
                            root.edit-refresh(text);
                        }
                    }
                }
            }

            // --- Storage and security (read-only) -------------------------------
            Card {
                title: "Storage and security";
                description: "Read-only. These come from the running app.";

                if (!Bridge.secrets-encrypted) : Rectangle {
                    border-radius: Design.radius-md;
                    border-width: 1px;
                    border-color: Design.warning;

                    HorizontalLayout {
                        padding: Design.space-md;
                        spacing: Design.space-sm;

                        IconTriangleAlert {
                            width: 16px;
                            height: 16px;
                            y: 2px;
                            stroke: Design.warning;
                            stroke-width: 2px;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: "Secrets are stored in a plain file because no OS keyring is available. Anyone who can read your user profile can read them.";
                            color: Design.foreground;
                            font-family: Design.font-family;
                            font-size: Design.font-sm;
                            wrap: word-wrap;
                        }
                    }
                }

                SettingRow {
                    label: "Secret storage";
                    description: Bridge.secret-backend != "" ? Bridge.secret-backend : "Not reported yet";
                }

                if (Bridge.secret-fallback-reason != "") : Text {
                    text: "Why the OS keyring was not used: " + Bridge.secret-fallback-reason;
                    color: Design.muted-foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-xs;
                    wrap: word-wrap;
                }

                VerticalLayout {
                    spacing: 2px;

                    Text {
                        text: "Data directory";
                        color: Design.foreground;
                        font-family: Design.font-family;
                        font-size: Design.font-sm;
                        font-weight: 500;
                    }

                    Text {
                        text: Bridge.data-dir != "" ? Bridge.data-dir : "Not reported yet";
                        color: Design.muted-foreground;
                        font-family: Design.font-family;
                        font-size: Design.font-xs;
                        wrap: word-wrap;
                    }
                }

                if (Bridge.secret-backend == "" && Bridge.data-dir == "") : EmptyState {
                    title: "Storage details not reported yet";
                    description: "The secret backend and data directory appear once the app has finished starting.";
                }

                ControlRow {
                    label: "Proxy engine";
                    description: Bridge.engine-installed
                        ? (Bridge.engine-version != "" ? "Installed, version " + Bridge.engine-version : "Installed")
                        : "Not installed yet.";

                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: end;

                        AppButton {
                            text: Bridge.engine-installed ? "Update engine" : "Install engine";
                            size: ButtonSize.lg;
                            busy: Bridge.busy;
                            busy-text: Bridge.busy-message;
                            enabled: !Bridge.busy;
                            disabled-reason: "Another operation is running. Wait for it to finish.";
                            clicked => {
                                Bridge.install-engine();
                            }
                        }
                    }
                }

                // Two-step clear: the first press asks, the second deletes.
                // Three buttons sit in this row when confirming, so its
                // control column is wider than the others.
                ControlRow {
                    label: "Cached subscription data";
                    control-width: 340px;
                    description: root.confirm-clear
                        ? "This deletes the downloaded subscription content. Your subscriptions stay configured."
                        : "Removes downloaded subscription content. It is fetched again on the next refresh.";

                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: Design.space-sm;
                        alignment: end;

                        if (!root.confirm-clear) : AppButton {
                            text: "Clear cache";
                            variant: ButtonVariant.outline;
                            size: ButtonSize.lg;
                            enabled: !Bridge.busy;
                            disabled-reason: "Another operation is running. Wait for it to finish.";
                            clicked => {
                                root.confirm-clear = true;
                            }
                        }

                        if (root.confirm-clear) : AppButton {
                            text: "Cancel";
                            variant: ButtonVariant.ghost;
                            clicked => {
                                root.confirm-clear = false;
                            }
                        }

                        if (root.confirm-clear) : AppButton {
                            text: "Delete cache";
                            variant: ButtonVariant.destructive;
                            size: ButtonSize.lg;
                            enabled: !Bridge.busy;
                            disabled-reason: "Another operation is running. Wait for it to finish.";
                            clicked => {
                                root.confirm-clear = false;
                                Bridge.clear-cache();
                            }
                        }
                    }
                }
            }
        }
    }

    // --- footer: errors, the unsaved hint, Discard and Save -------------------

    if (Bridge.loaded) : VerticalLayout {
        spacing: Design.space-xs;
        vertical-stretch: 0;

        if (Bridge.settings-error != "") : Text {
            text: Bridge.settings-error;
            color: Design.destructive;
            font-family: Design.font-family;
            font-size: Design.font-sm;
            font-weight: 500;
            wrap: word-wrap;
        }

        if (root.dirty) : Text {
            text: "You have unsaved changes.";
            color: Design.warning;
            font-family: Design.font-family;
            font-size: Design.font-xs;
        }

        HorizontalLayout {
            spacing: Design.space-sm;
            alignment: end;

            AppButton {
                text: "Discard";
                variant: ButtonVariant.secondary;
                enabled: root.dirty && !Bridge.busy;
                disabled-reason: Bridge.busy ? "Another operation is running. Wait for it to finish." : "There are no changes to discard.";
                clicked => {
                    root.resync();
                }
            }

            AppButton {
                text: "Save";
                variant: ButtonVariant.default;
                enabled: root.can-save;
                disabled-reason: root.save-blocker;
                clicked => {
                    Bridge.save-settings(root.draft);
                }
            }
        }
    }
}
