// ConnectionsPage: the live connections through the proxy, in the style of
// Koala. Rust polls the lists about once a second while this page is open
// and not paused, and filters and sorts them; this page only shows them and
// writes the controls back to the Bridge.
//
// The list fills the window below the header and the toolbar, so the page
// does not use PageFrame: a ScrollView around a ListView would give the list
// no height to scroll in.

import { Design } from "../design.slint";
import { Bridge, ConnectionItem, SelectItem } from "../bridge.slint";
import {
    Button, ButtonVariant, ButtonSize, IconButton, Input, Select, Segmented,
    Switch, ConfirmDialog, EmptyState, PageHeader
} from "../primitives.slint";
import { EmojiText } from "../emoji-text.slint";
import { ListView } from "std-widgets.slint";

// An upload or download line: an arrow, the total and the current speed.
component TrafficLine inherits HorizontalLayout {
    in property <image> icon;
    in property <string> total;
    in property <string> speed;

    spacing: 6px;

    VerticalLayout {
        alignment: center;
        width: 12px;

        Image {
            width: 12px;
            height: 12px;
            source: root.icon;
            colorize: Design.muted-foreground;
        }
    }

    Text {
        text: root.total;
        width: 70px;
        color: Design.foreground;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    Text {
        text: root.speed;
        width: 74px;
        color: Design.muted-foreground;
        font-family: Design.font-family;
        font-size: Design.font-xs;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }
}

// One connection: the host and process on the first line; the chain and the
// matched rule, muted, on the second; then the traffic, the duration and, on
// the active tab, the button that closes it.
component ConnectionRow inherits Rectangle {
    in property <ConnectionItem> item;
    in property <bool> closable: false;
    callback close-clicked(string);

    height: 64px;
    background: ta.has-hover ? Design.card-hover : transparent;

    // Behind the content: the hover above, and the layout on top, so the
    // close button takes its own clicks.
    ta := TouchArea {
        mouse-cursor: default;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 16px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 3px;

            HorizontalLayout {
                spacing: 8px;

                EmojiText {
                    runs: root.item.host-runs;
                    fallback: root.item.host;
                    font-size: Design.font-base;
                    font-weight: 500;
                    color: Design.foreground;
                    wrap: false;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }

                if (root.item.process != "") : Text {
                    text: root.item.process;
                    color: Design.muted-foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-xs;
                    horizontal-stretch: 0;
                    max-width: 160px;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                EmojiText {
                    runs: root.item.chain-runs;
                    fallback: root.item.chain;
                    font-size: Design.font-xs;
                    color: Design.muted-foreground;
                    wrap: false;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }

                if (root.item.rule != "") : Text {
                    text: root.item.rule;
                    color: Design.subtle-foreground;
                    font-family: Design.font-family;
                    font-size: Design.font-xs;
                    horizontal-stretch: 0;
                    max-width: 160px;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            spacing: 3px;

            TrafficLine {
                icon: @image-url("../assets/icons/arrow-down.svg");
                total: root.item.download;
                speed: root.item.download-speed;
            }

            TrafficLine {
                icon: @image-url("../assets/icons/arrow-up.svg");
                total: root.item.upload;
                speed: root.item.upload-speed;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Text {
                text: root.item.duration;
                width: 60px;
                color: Design.muted-foreground;
                font-family: Design.font-family;
                font-size: Design.font-xs;
                horizontal-alignment: right;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            if (root.closable) : IconButton {
                icon: @image-url("../assets/icons/x.svg");
                size: ButtonSize.sm;
                tooltip: @tr("Close this connection");
                clicked => {
                    root.close-clicked(root.item.id);
                }
            }
        }
    }

    // The row separator.
    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Design.border;
    }
}

export component ConnectionsPage inherits Rectangle {
    // 0 Active, 1 Closed
    private property <int> tab: 0;
    private property <[ConnectionItem]> shown: root.tab == 0 ? Bridge.connections : Bridge.closed-connections;
    private property <bool> not-running: Bridge.engine-phase != "running";

    private property <[SelectItem]> sort-items: [
        { text: @tr("Newest"), detail: "", detail-color: Design.muted-foreground, text-runs: [] },
        { text: @tr("Upload"), detail: "", detail-color: Design.muted-foreground, text-runs: [] },
        { text: @tr("Download"), detail: "", detail-color: Design.muted-foreground, text-runs: [] },
        { text: @tr("Host"), detail: "", detail-color: Design.muted-foreground, text-runs: [] }
    ];

    private property <string> empty-title: root.tab == 1 ? @tr("No closed connections")
        : root.not-running ? @tr("Not connected")
        : Bridge.connections-filter != "" ? @tr("No matches")
        : @tr("No connections");
    private property <string> empty-text: root.tab == 1 ? @tr("Connections that end show up here.")
        : root.not-running ? @tr("Connect to see the connections that pass through the proxy.")
        : Bridge.connections-filter != "" ? @tr("No connection matches the filter.")
        : @tr("Connections show up here as apps use the proxy.");

    close-dialog := ConfirmDialog {
        width: parent.width;
        height: parent.height;
        title: @tr("Close all connections?");
        message: @tr("Every open connection is closed now. Apps can open new ones.");
        confirm-text: @tr("Close all");
        confirmed => {
            close-dialog.close();
            Bridge.close-all-connections();
        }
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 28px;
        padding-bottom: 32px;

        VerticalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            max-width: 920px;
            spacing: 0px;

            PageHeader {
                title: @tr("Connections");
                description: @tr("{} active", Bridge.connections-active-count)
                    + (Bridge.connections-total-upload == "" ? "" : @tr(" · {} uploaded", Bridge.connections-total-upload))
                    + (Bridge.connections-total-download == "" ? "" : @tr(" · {} downloaded", Bridge.connections-total-download));
            }

            // The toolbar: the filter, the sort, the pause switch and Close all.
            VerticalLayout {
                spacing: 12px;
                padding-bottom: 16px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 36px;

                    Input {
                        preferred-width: 260px;
                        min-width: 160px;
                        horizontal-stretch: 1;
                        placeholder: @tr("Filter by host, process, chain or rule");
                        icon: @image-url("../assets/icons/search.svg");
                        text <=> Bridge.connections-filter;
                    }

                    Select {
                        items: root.sort-items;
                        current-index <=> Bridge.connections-sort;
                        preferred-width: 140px;
                        horizontal-stretch: 0;
                        popup-min-width: 140px;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 0;

                        VerticalLayout {
                            alignment: center;

                            Switch {
                                checked: Bridge.connections-paused;
                                toggled(value) => {
                                    Bridge.connections-paused = value;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: Bridge.connections-paused ? @tr("Paused") : @tr("Pause");
                                color: Design.foreground;
                                font-family: Design.font-family;
                                font-size: Design.font-sm;
                                height: 20px;
                                vertical-alignment: center;
                                wrap: no-wrap;
                            }
                        }
                    }

                    Button {
                        text: @tr("Close all");
                        variant: ButtonVariant.destructive-outline;
                        size: ButtonSize.md;
                        horizontal-stretch: 0;
                        icon: @image-url("../assets/icons/x.svg");
                        enabled: Bridge.connections-active-count > 0;
                        clicked => {
                            close-dialog.show();
                        }
                    }
                }

                // The tabs, and Clear on the closed history.
                HorizontalLayout {
                    spacing: 8px;
                    height: 36px;

                    Segmented {
                        options: [@tr("Active"), @tr("Closed")];
                        current-index: root.tab;
                        selected(index) => {
                            root.tab = index;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if (root.tab == 1) : Button {
                        text: @tr("Clear");
                        variant: ButtonVariant.ghost;
                        size: ButtonSize.sm;
                        horizontal-stretch: 0;
                        icon: @image-url("../assets/icons/trash-2.svg");
                        enabled: Bridge.closed-connections.length > 0;
                        clicked => {
                            Bridge.clear-closed-connections();
                        }
                    }
                }
            }

            // The list. It takes the rest of the window and scrolls.
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 120px;
                background: Design.card;
                border-width: 1px;
                border-color: Design.border;
                border-radius: Design.radius-lg;
                clip: true;

                if (root.shown.length > 0) : ListView {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;

                    for conn in root.shown : ConnectionRow {
                        item: conn;
                        closable: root.tab == 0;
                        close-clicked(id) => {
                            Bridge.close-connection(id);
                        }
                    }
                }

                if (root.shown.length == 0) : VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;

                    EmptyState {
                        icon: @image-url("../assets/icons/activity.svg");
                        title: root.empty-title;
                        text: root.empty-text;
                        action-text: root.tab == 0 && root.not-running ? @tr("Go to Home") : "";
                        action => {
                            Bridge.active-page = 0;
                        }
                    }
                }
            }
        }
    }
}
